---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AlbumFlipbook from '../components/AlbumFlipbook.astro';
import { getCollection } from 'astro:content';

const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
const description = '完整攝影集，用左右箭頭或滑動切換每個主題。';
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`Portfolio - ${SITE_TITLE}`} description={description} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<section class="px-6 pb-10 pt-32 md:pb-14 md:pt-40">
				<div class="container mx-auto max-w-5xl text-center">
					<p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-app-gray-500">Portfolio</p>
					<h1 class="font-serif text-3xl font-semibold tracking-tight text-app-text md:text-4xl">
						攝影集
					</h1>
					<p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-app-gray-600 md:text-base">
						{description}
					</p>
				</div>
			</section>

			<section class="px-6 pb-20 md:pb-28">
				<div class="mx-auto max-w-6xl">
					{
						albums.length > 0 ? (
							<AlbumFlipbook albums={albums} />
						) : (
							<p class="text-center text-app-gray-500">還沒有相簿。</p>
						)
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
