---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AlbumMosaic from '../components/AlbumMosaic.astro';
import { getCollection } from 'astro:content';

const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
const totalPhotos = albums.reduce((sum, album) => sum + album.data.images.length, 0);
const description = '每個主題各自獨立，點進去看完整的一組照片。';

// 版面：書名頁（中軸）＋鑲嵌塊面預覽。
// 與首頁共用 AlbumMosaic，差別只在這裡列出全部主題、首頁是精選。
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`Portfolio — ${SITE_TITLE}`} description={description} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<!-- 書名頁：中軸置中，上下留大白讓讀者先停一拍 -->
			<section class="page-wide pb-16 pt-44 md:pb-24 md:pt-56">
				<div class="axis">
					<p class="label">
						{String(albums.length).padStart(2, '0')} Series · {totalPhotos} Photographs
					</p>
					<h1 class="title-display mt-9 text-app-ink">Portfolio</h1>
					<p class="body-small mx-auto mt-8 max-w-[38ch]">
						{description}
					</p>
				</div>
			</section>

			<!-- 塊面預覽：微灰區帶，照片浮在紙上 -->
			<section class="band-tint page-narrow band">
				{
					albums.length > 0 ? (
						<AlbumMosaic albums={albums} />
					) : (
						<p class="body-small text-center">還沒有相簿。</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
