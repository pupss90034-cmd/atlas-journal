---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';
const SITE_DESCRIPTION = siteSettings?.data.description ?? '';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 分類＝文章所在的資料夾（Obsidian 裡怎麼分資料夾，這裡就自動長出對應分類，
// 不用寫死名稱）。之後改資料夾名稱或搬動文章，分類清單會自動跟著變。
const categories = [
	...new Set(
		posts
			.map((post) => (post.id.includes('/') ? post.id.split('/')[0] : null))
			.filter((c): c is string => Boolean(c)),
	),
];

// 標籤＝每篇文章 frontmatter 裡的 tags 清單，同樣是動態算出來的。
// 之後在 Obsidian 裡新增、改名、刪除標籤，這裡的清單跟篩選都會自動更新。
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) =>
	a.localeCompare(b, 'zh-Hant'),
);
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<section class="px-6 pb-10 pt-32 md:pb-14 md:pt-40">
				<div class="container mx-auto max-w-5xl text-center">
					<p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-app-gray-500">Journal</p>
					<h1 class="font-serif text-3xl font-semibold tracking-tight text-app-text md:text-4xl">
						所有文章
					</h1>
					<p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-app-gray-600 md:text-base">
						{SITE_DESCRIPTION}
					</p>
					<p id="search-status" class="mx-auto mt-4 hidden max-w-md text-xs uppercase tracking-[0.15em] text-app-accent"></p>
				</div>
			</section>

			<section class="px-6 pb-16 md:pb-24">
				<div class="container mx-auto max-w-5xl">
					{
						categories.length > 0 && (
							<div class="mb-6 flex flex-wrap justify-center gap-x-6 gap-y-2 border-y border-app-gray-200 py-4" id="category-filter">
								<button
									type="button"
									data-category=""
									class="filter-btn text-xs font-medium uppercase tracking-[0.15em] text-app-text transition-colors duration-300"
								>
									全部分類
								</button>
								{categories.map((category) => (
									<button
										type="button"
										data-category={category}
										class="filter-btn text-xs font-medium uppercase tracking-[0.15em] text-app-gray-400 transition-colors duration-300 hover:text-app-text"
									>
										{category}
									</button>
								))}
							</div>
						)
					}

					{
						tags.length > 0 && (
							<div class="mb-10 flex flex-wrap items-center justify-center gap-2 md:mb-14" id="tag-filter">
								<span class="mr-1 text-xs font-medium uppercase tracking-[0.15em] text-app-gray-400">標籤</span>
								{tags.map((tag) => (
									<button
										type="button"
										data-tag={tag}
										class="tag-btn rounded-full border border-app-gray-300 px-3.5 py-1.5 text-xs text-app-gray-600 transition-colors duration-300 hover:border-app-moss hover:text-app-moss-dark"
									>
										#{tag}
									</button>
								))}
							</div>
						)
					}

					{
						posts.length > 0 ? (
							<div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3" id="post-grid">
								{posts.map((post) => (
									<div
										class="post-item"
										data-category={post.id.includes('/') ? post.id.split('/')[0] : ''}
										data-tags={(post.data.tags ?? []).join('|').toLowerCase()}
										data-title={post.data.title.toLowerCase()}
										data-description={post.data.description.toLowerCase()}
									>
										<BlogCard post={post} />
									</div>
								))}
							</div>
						) : (
							<p class="text-app-gray-500">還沒有發佈的文章。</p>
						)
					}
					<p id="empty-state" class="hidden py-16 text-center text-sm text-app-gray-500">
						沒有符合的文章，換個關鍵字試試。
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tag-btn[data-active='true'] {
		border-color: var(--color-app-moss);
		background: var(--color-app-moss-soft);
		color: var(--color-app-moss-dark);
	}
</style>

<script>
	const categoryButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
	const items = document.querySelectorAll<HTMLDivElement>('.post-item');
	const emptyState = document.getElementById('empty-state');
	const searchStatus = document.getElementById('search-status');

	const params = new URLSearchParams(window.location.search);
	let activeCategory = '';
	let activeTag = params.get('tag')?.trim().toLowerCase() ?? '';
	let activeQuery = params.get('q')?.trim().toLowerCase() ?? '';

	function applyFilters() {
		let visibleCount = 0;
		items.forEach((item) => {
			const itemTags = item.dataset.tags?.split('|') ?? [];
			const matchesCategory = !activeCategory || item.dataset.category === activeCategory;
			const matchesTag = !activeTag || itemTags.includes(activeTag);
			const matchesQuery =
				!activeQuery ||
				item.dataset.title?.includes(activeQuery) ||
				item.dataset.description?.includes(activeQuery) ||
				itemTags.some((tag) => tag.includes(activeQuery));
			const show = matchesCategory && matchesTag && matchesQuery;
			item.classList.toggle('hidden', !show);
			if (show) visibleCount += 1;
		});
		emptyState?.classList.toggle('hidden', visibleCount > 0);

		if (activeQuery && searchStatus) {
			searchStatus.textContent = `搜尋「${activeQuery}」的結果`;
			searchStatus.classList.remove('hidden');
		} else if (activeTag && searchStatus) {
			searchStatus.textContent = `標籤「${activeTag}」的文章`;
			searchStatus.classList.remove('hidden');
		} else if (searchStatus) {
			searchStatus.classList.add('hidden');
		}
	}

	categoryButtons.forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.category ?? '';

			categoryButtons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('text-app-text', active);
				b.classList.toggle('text-app-gray-400', !active);
			});

			applyFilters();
		});
	});

	tagButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const tag = (button.dataset.tag ?? '').toLowerCase();
			const turningOff = activeTag === tag;
			activeTag = turningOff ? '' : tag;

			tagButtons.forEach((b) => {
				b.dataset.active = !turningOff && b === button ? 'true' : 'false';
			});

			applyFilters();
		});
	});

	// 如果是從文章頁的標籤連結進來（/blog?tag=xxx），先把對應的標籤按鈕標成選取狀態。
	if (activeTag) {
		tagButtons.forEach((b) => {
			b.dataset.active = (b.dataset.tag ?? '').toLowerCase() === activeTag ? 'true' : 'false';
		});
	}

	applyFilters();
</script>
