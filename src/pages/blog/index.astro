---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';
const SITE_DESCRIPTION = siteSettings?.data.description ?? '';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [
	...new Set(
		posts
			.map((post) => (post.id.includes('/') ? post.id.split('/')[0] : null))
			.filter((c): c is string => Boolean(c)),
	),
];
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<section class="px-6 pb-10 pt-32 md:pb-14 md:pt-40">
				<div class="container mx-auto max-w-5xl text-center">
					<p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-app-gray-500">Journal</p>
					<h1 class="font-serif text-3xl font-semibold tracking-tight text-app-text md:text-4xl">
						所有文章
					</h1>
					<p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-app-gray-600 md:text-base">
						{SITE_DESCRIPTION}
					</p>
					<p id="search-status" class="mx-auto mt-4 hidden max-w-md text-xs uppercase tracking-[0.15em] text-app-accent"></p>
				</div>
			</section>

			<section class="px-6 pb-16 md:pb-24">
				<div class="container mx-auto max-w-5xl">
					{
						categories.length > 0 && (
							<div class="mb-10 flex flex-wrap justify-center gap-x-6 gap-y-2 border-y border-app-gray-200 py-4 md:mb-14" id="category-filter">
								<button
									type="button"
									data-category=""
									class="filter-btn text-xs font-medium uppercase tracking-[0.15em] text-app-text transition-colors duration-300"
								>
									全部
								</button>
								{categories.map((category) => (
									<button
										type="button"
										data-category={category}
										class="filter-btn text-xs font-medium uppercase tracking-[0.15em] text-app-gray-400 transition-colors duration-300 hover:text-app-text"
									>
										{category}
									</button>
								))}
							</div>
						)
					}

					{
						posts.length > 0 ? (
							<div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3" id="post-grid">
								{posts.map((post) => (
									<div
										class="post-item"
										data-category={post.id.includes('/') ? post.id.split('/')[0] : ''}
										data-title={post.data.title.toLowerCase()}
										data-description={post.data.description.toLowerCase()}
									>
										<BlogCard post={post} />
									</div>
								))}
							</div>
						) : (
							<p class="text-app-gray-500">還沒有發佈的文章。</p>
						)
					}
					<p id="empty-state" class="hidden py-16 text-center text-sm text-app-gray-500">
						沒有符合的文章，換個關鍵字試試。
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const items = document.querySelectorAll<HTMLDivElement>('.post-item');
	const emptyState = document.getElementById('empty-state');
	const searchStatus = document.getElementById('search-status');

	let activeCategory = '';
	let activeQuery = new URLSearchParams(window.location.search).get('q')?.trim().toLowerCase() ?? '';

	function applyFilters() {
		let visibleCount = 0;
		items.forEach((item) => {
			const matchesCategory = !activeCategory || item.dataset.category === activeCategory;
			const matchesQuery =
				!activeQuery ||
				item.dataset.title?.includes(activeQuery) ||
				item.dataset.description?.includes(activeQuery);
			const show = matchesCategory && matchesQuery;
			item.classList.toggle('hidden', !show);
			if (show) visibleCount += 1;
		});
		emptyState?.classList.toggle('hidden', visibleCount > 0);

		if (activeQuery && searchStatus) {
			searchStatus.textContent = `搜尋「${activeQuery}」的結果`;
			searchStatus.classList.remove('hidden');
		} else if (searchStatus) {
			searchStatus.classList.add('hidden');
		}
	}

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.category ?? '';

			buttons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('text-app-text', active);
				b.classList.toggle('text-app-gray-400', !active);
			});

			applyFilters();
		});
	});

	applyFilters();
</script>
