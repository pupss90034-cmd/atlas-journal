---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [
	...new Set(
		posts
			.map((post) => (post.id.includes('/') ? post.id.split('/')[0] : null))
			.filter((c): c is string => Boolean(c)),
	),
];
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<section class="px-6 pb-8 pt-10 md:pb-10 md:pt-[72px] lg:pb-12">
				<div class="container mx-auto max-w-5xl">
					<div class="flex flex-col-reverse items-center gap-2.5 text-center md:gap-4">
						<h1 class="text-2xl font-medium leading-none tracking-tight text-app-text md:text-3xl lg:text-[56px]">
							所有文章
						</h1>
						<h2 class="text-sm leading-none tracking-tight text-app-gray-600 md:text-base lg:text-xl">
							{SITE_DESCRIPTION}
						</h2>
					</div>
				</div>
			</section>

			<section class="px-6 pb-16 md:pb-24">
				<div class="container mx-auto max-w-5xl">
					{
						categories.length > 0 && (
							<div class="mb-8 flex flex-wrap justify-center gap-2.5 lg:mb-12" id="category-filter">
								<button
									type="button"
									data-category=""
									class="filter-btn flex items-center justify-center rounded-full border border-app-text bg-app-text px-6 py-2.5 text-xs leading-none tracking-tight text-white transition-colors duration-300 md:text-base lg:px-6 lg:py-[14px] lg:text-xl"
								>
									全部
								</button>
								{categories.map((category) => (
									<button
										type="button"
										data-category={category}
										class="filter-btn flex items-center justify-center rounded-full border border-app-gray-300 px-6 py-2.5 text-xs leading-none tracking-tight text-app-text transition-colors duration-300 md:text-base lg:px-6 lg:py-[14px] lg:text-xl"
									>
										{category}
									</button>
								))}
							</div>
						)
					}

					<h2 class="mb-7 text-lg font-medium leading-none tracking-tight text-app-text md:mb-10 lg:mb-12 lg:text-[32px]">
						全部文章
					</h2>

					{
						posts.length > 0 ? (
							<div
								class="grid grid-cols-1 gap-6 rounded-2xl border border-app-gray-300 p-4 md:grid-cols-2 lg:grid-cols-3 xl:gap-10 xl:p-8"
								id="post-grid"
							>
								{posts.map((post) => (
									<div
										class="post-item"
										data-category={post.id.includes('/') ? post.id.split('/')[0] : ''}
									>
										<BlogCard post={post} />
									</div>
								))}
							</div>
						) : (
							<p class="text-app-gray-500">還沒有發佈的文章。</p>
						)
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const items = document.querySelectorAll<HTMLDivElement>('.post-item');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const category = button.dataset.category ?? '';

			buttons.forEach((b) => {
				const active = b === button;
				b.classList.toggle('bg-app-text', active);
				b.classList.toggle('text-white', active);
				b.classList.toggle('border-app-text', active);
				b.classList.toggle('border-app-gray-300', !active);
			});

			items.forEach((item) => {
				const show = !category || item.dataset.category === category;
				item.classList.toggle('hidden', !show);
			});
		});
	});
</script>
