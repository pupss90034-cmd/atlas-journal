---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { getSortedPosts, getCategory, getCategories } from '../../utils/posts';
import { parseEditableBlock } from '../../utils/editableBody';

const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';
const SITE_DESCRIPTION = siteSettings?.data.description ?? '';

// 2026-08-10：這一頁的大標與底下的引導小字改成從 Obsidian 編輯
//（編輯/頁面-文章總覽.md）。以前標題寫死成 Journal，小字直接拿
// 網站簡介充數——等於這一頁從來沒有被寫過字。
const introEntry = (await getCollection('pageIntros')).find((e) =>
	(e.filePath ?? e.id).includes('文章總覽'),
);
const pageHeading = introEntry?.data.heading ?? 'Journal';
const pageIntro = parseEditableBlock(introEntry?.body).intro || SITE_DESCRIPTION;

const posts = await getSortedPosts();

// 分類＝文章所在的資料夾，但**脫掉排序前綴**：Obsidian 裡叫「A - 旅行隨記」，
// 網站上顯示「旅行隨記」。那個 A 是你用來排側邊欄順序的，讀者不需要看到。
// 邏輯在 src/utils/posts.ts 的 getCategory()。
const categories = getCategories(posts);

// 標籤＝每篇文章 frontmatter 裡的 tags 清單，動態算出來的。
// 之後在 Obsidian 裡新增、改名、刪除標籤，這裡的清單跟篩選都會自動更新。
//
// 2026-08-10 傍晚：標籤退回純文字列。稍早改成的世界地圖搬去首頁了
//（src/components/home/TravelMap.astro）。原因是這兩件事目的不同：
// 這一頁的標籤是**篩選工具**，讀者要的是一眼掃完、馬上點到；
// 地圖是**自我介紹**，屬於首頁。工具就該長得像工具。
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) =>
	a.localeCompare(b, 'zh-Hant'),
);

// 版面：書名頁（中軸）＋兩欄圖版。
// 原本是三欄卡片格線，三欄會把圖壓得太小、讀起來像列表頁；
// 改成兩欄大圖，並把分類／標籤篩選改成純文字列，去掉所有藥丸按鈕。
//
// 2026-08-07：圖版整體縮小（max-w-6xl → 5xl，卡片同步改橫幅），
// 並加入每頁 8 篇的分頁。分頁做在前端而不是拆成 /blog/2/，
// 因為分類與標籤篩選也是前端跑的——如果分頁在後端，
// 篩選就只會作用在當前這 8 篇上，等於壞掉。
const PAGE_SIZE = 8;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`Journal — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<!-- 書名頁：中軸 -->
			<section class="page-wide pb-14 pt-40 md:pb-20 md:pt-52">
				<div class="axis">
					<!-- 眉標放「共幾篇」而不是重複標題本身，避免同一個字出現兩次 -->
					<p class="label">{String(posts.length).padStart(2, '0')} Entries</p>
					<h1 class="title-h1 mt-7 text-app-ink">{pageHeading}</h1>
					<p class="body-small mx-auto mt-6 max-w-[34ch]">
						{pageIntro}
					</p>
					<p id="search-status" class="label mx-auto mt-8 hidden text-app-ink"></p>
				</div>
			</section>

			<!-- 篩選：純文字，兩列，用細線與上方標題頁分開 -->
			<section class="page-wide">
				<div class="mx-auto max-w-6xl">
					{
						categories.length > 0 && (
							<div class="flex flex-wrap justify-center gap-x-8 gap-y-3 border-t border-app-gray-200 py-5" id="category-filter">
								<button type="button" data-category="" class="filter-btn label" data-active="true">
									All
								</button>
								{categories.map((category) => (
									<button type="button" data-category={category} class="filter-btn label">
										{category}
									</button>
								))}
							</div>
						)
					}

					{
						tags.length > 0 && (
							<div class="flex flex-wrap items-baseline justify-center gap-x-7 gap-y-3 border-y border-app-gray-200 py-5" id="tag-filter">
								{tags.map((tag) => (
									<button type="button" data-tag={tag} class="tag-btn label">
										{tag}
									</button>
								))}
							</div>
						)
					}
				</div>
			</section>

			{/* 圖版：兩欄「齊頭齊尾」，鋪微灰區帶讓圖片浮在紙上。
			    2026-08-09：拿掉原本偶數欄往下推的錯落（.stagger）。
			    錯落適合作品集那種「隨意瀏覽」的版面；文章列表是一份
			    要被掃讀的目錄，同一列的兩篇必須對齊，讀者才能用
			    「一列＝一組」的方式往下讀，日期與標題也才對得起來。
			    規則：文章相關的版面一律不做錯落。 */}
			<section class="band-tint page-wide pb-28 pt-20 md:pb-36 md:pt-28">
				<div class="mx-auto max-w-5xl">
					{
						posts.length > 0 ? (
							<div class="grid grid-cols-1 items-start gap-x-10 gap-y-14 sm:grid-cols-2 md:gap-x-14 md:gap-y-16" id="post-grid">
								{posts.map((post) => (
									<div
										class="post-item"
										data-category={getCategory(post)}
										data-tags={(post.data.tags ?? []).join('|').toLowerCase()}
										data-title={post.data.title.toLowerCase()}
										data-description={post.data.description.toLowerCase()}
									>
										<BlogCard post={post} />
									</div>
								))}
							</div>
						) : (
							<p class="body-small text-center">還沒有發佈的文章。</p>
						)
					}
					<p id="empty-state" class="body-small hidden py-20 text-center">
						沒有符合的文章，換個關鍵字試試。
					</p>

					<!-- 分頁：每頁 8 篇。沿用全站單色語彙——不用藥丸按鈕、
					     不用色塊，選取狀態只靠一條底線與墨色深淺。 -->
					<nav
						id="pagination"
						class="mt-20 hidden border-t border-app-gray-200 pt-10 md:mt-28"
						aria-label="文章分頁"
					>
						<div class="flex items-center justify-center gap-x-7">
							<button type="button" id="page-prev" class="page-arrow label" aria-label="上一頁">←</button>
							<div id="page-numbers" class="flex items-center gap-x-5"></div>
							<button type="button" id="page-next" class="page-arrow label" aria-label="下一頁">→</button>
						</div>
						<p id="page-status" class="label mt-7 text-center"></p>
					</nav>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* 選取狀態：不換顏色，只加一條底線並轉深 —— 單色系統的層級做法 */
	.filter-btn,
	.tag-btn {
		border-bottom: 1px solid transparent;
		padding-bottom: 0.3em;
		transition: color 0.4s ease, border-color 0.4s ease;
	}
	.filter-btn:hover,
	.tag-btn:hover {
		color: var(--color-app-ink);
	}
	.filter-btn[data-active='true'],
	.tag-btn[data-active='true'] {
		color: var(--color-app-ink);
		border-bottom-color: var(--color-app-ink);
	}

	/* 分頁：與篩選同一套語彙 */
	.page-num,
	.page-arrow {
		border-bottom: 1px solid transparent;
		padding-bottom: 0.3em;
		transition: color 0.4s ease, border-color 0.4s ease, opacity 0.4s ease;
	}
	.page-num:hover,
	.page-arrow:hover:not(:disabled) {
		color: var(--color-app-ink);
	}
	.page-num[data-active='true'] {
		color: var(--color-app-ink);
		border-bottom-color: var(--color-app-ink);
	}
	.page-arrow:disabled {
		opacity: 0.25;
		cursor: default;
	}
	/* 省略號：不可點，只是視覺上的連續 */
	.page-gap {
		color: var(--color-app-gray-300);
	}
</style>

<script>
	const categoryButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
	const items = document.querySelectorAll<HTMLDivElement>('.post-item');
	const emptyState = document.getElementById('empty-state');
	const searchStatus = document.getElementById('search-status');

	// ── 分頁 ─────────────────────────────────────────────
	// 每頁 8 篇。注意順序：先算出「通過篩選的文章」，再對那份清單分頁。
	// 反過來（先分頁再篩選）會變成只在當前 8 篇裡找，那是壞掉的行為。
	const PAGE_SIZE = 8;
	const pagination = document.getElementById('pagination');
	const pageNumbers = document.getElementById('page-numbers');
	const pagePrev = document.getElementById('page-prev') as HTMLButtonElement | null;
	const pageNext = document.getElementById('page-next') as HTMLButtonElement | null;
	const pageStatus = document.getElementById('page-status');
	const grid = document.getElementById('post-grid');
	let currentPage = 1;

	const params = new URLSearchParams(window.location.search);
	let activeCategory = '';
	let activeTag = params.get('tag')?.trim().toLowerCase() ?? '';
	let activeQuery = params.get('q')?.trim().toLowerCase() ?? '';

	/** 通過目前分類／標籤／關鍵字篩選的文章（尚未分頁）。 */
	function matchedItems() {
		return Array.from(items).filter((item) => {
			const itemTags = item.dataset.tags?.split('|') ?? [];
			const matchesCategory = !activeCategory || item.dataset.category === activeCategory;
			const matchesTag = !activeTag || itemTags.includes(activeTag);
			const matchesQuery =
				!activeQuery ||
				item.dataset.title?.includes(activeQuery) ||
				item.dataset.description?.includes(activeQuery) ||
				itemTags.some((tag) => tag.includes(activeQuery));
			return matchesCategory && matchesTag && matchesQuery;
		});
	}

	/** 畫出頁碼列。頁數多的時候只顯示首尾與當前頁附近，中間用 … 帶過。 */
	function renderPageNumbers(totalPages: number) {
		if (!pageNumbers) return;
		pageNumbers.innerHTML = '';

		const shown = new Set<number>([1, totalPages, currentPage]);
		if (currentPage - 1 > 1) shown.add(currentPage - 1);
		if (currentPage + 1 < totalPages) shown.add(currentPage + 1);
		const pages = [...shown].filter((p) => p >= 1 && p <= totalPages).sort((a, b) => a - b);

		let previous = 0;
		for (const page of pages) {
			if (previous && page - previous > 1) {
				const gap = document.createElement('span');
				gap.className = 'label page-gap';
				gap.textContent = '…';
				pageNumbers.append(gap);
			}
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'page-num label';
			button.textContent = String(page).padStart(2, '0');
			button.dataset.active = page === currentPage ? 'true' : 'false';
			if (page === currentPage) button.setAttribute('aria-current', 'page');
			button.addEventListener('click', () => goToPage(page));
			pageNumbers.append(button);
			previous = page;
		}
	}

	function goToPage(page: number) {
		currentPage = page;
		applyFilters({ resetPage: false });
		// 換頁後回到圖版頂端，不然會停在上一頁的底部、看不出換了內容
		grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	}

	function applyFilters({ resetPage = true } = {}) {
		if (resetPage) currentPage = 1;

		const matched = matchedItems();
		const totalPages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
		if (currentPage > totalPages) currentPage = totalPages;

		const start = (currentPage - 1) * PAGE_SIZE;
		const visible = new Set(matched.slice(start, start + PAGE_SIZE));

		items.forEach((item) => item.classList.toggle('hidden', !visible.has(item)));
		emptyState?.classList.toggle('hidden', matched.length > 0);

		// 一頁就放得下時整組分頁收起來，不留一個只有「01」的殘留元件
		const needsPagination = matched.length > PAGE_SIZE;
		pagination?.classList.toggle('hidden', !needsPagination);
		if (needsPagination) {
			renderPageNumbers(totalPages);
			if (pagePrev) pagePrev.disabled = currentPage === 1;
			if (pageNext) pageNext.disabled = currentPage === totalPages;
			if (pageStatus) {
				pageStatus.textContent = `第 ${currentPage} / ${totalPages} 頁 · 共 ${matched.length} 篇`;
			}
		}

		if (activeQuery && searchStatus) {
			searchStatus.textContent = `搜尋「${activeQuery}」`;
			searchStatus.classList.remove('hidden');
		} else if (activeTag && searchStatus) {
			searchStatus.textContent = `標籤「${activeTag}」`;
			searchStatus.classList.remove('hidden');
		} else if (searchStatus) {
			searchStatus.classList.add('hidden');
		}
	}

	pagePrev?.addEventListener('click', () => {
		if (currentPage > 1) goToPage(currentPage - 1);
	});
	pageNext?.addEventListener('click', () => goToPage(currentPage + 1));

	categoryButtons.forEach((button) => {
		button.addEventListener('click', () => {
			activeCategory = button.dataset.category ?? '';
			categoryButtons.forEach((b) => {
				b.dataset.active = b === button ? 'true' : 'false';
			});
			applyFilters();
		});
	});

	tagButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const tag = (button.dataset.tag ?? '').toLowerCase();
			const turningOff = activeTag === tag;
			activeTag = turningOff ? '' : tag;
			tagButtons.forEach((b) => {
				b.dataset.active = !turningOff && b === button ? 'true' : 'false';
			});
			applyFilters();
		});
	});

	// 如果是從文章頁的標籤連結進來（/blog?tag=xxx），先把對應的標籤標成選取狀態。
	if (activeTag) {
		tagButtons.forEach((b) => {
			b.dataset.active = (b.dataset.tag ?? '').toLowerCase() === activeTag ? 'true' : 'false';
		});
	}

	applyFilters();
</script>
