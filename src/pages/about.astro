---
import Layout from '../layouts/BlogPost.astro';
import { getCollection, render } from 'astro:content';

const [aboutEntry] = await getCollection('aboutPage');
if (!aboutEntry) {
	throw new Error('找不到「About頁面.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { title, description, pubDate } = aboutEntry.data;
const { Content } = await render(aboutEntry);
---

<Layout title={title} description={description} pubDate={pubDate}>
	<Content />
</Layout>
