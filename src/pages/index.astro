---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featuredPost, ...rest] = posts;
const otherPosts = rest.slice(0, 6);

// Build one representative "category" tile per top-level folder, using the
// most recent post in that folder as the thumbnail + link.
const categoryMap = new Map<string, (typeof posts)[number]>();
for (const post of posts) {
	if (!post.id.includes('/')) continue;
	const category = post.id.split('/')[0];
	if (!categoryMap.has(category)) {
		categoryMap.set(category, post);
	}
}
const categoryTiles = [...categoryMap.entries()].slice(0, 4);
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			{
				featuredPost && (
					<section class="px-6 pb-16 pt-10 md:pb-20 md:pt-14">
						<div class="container mx-auto max-w-5xl">
							<a
								href={`/blog/${featuredPost.id}/`}
								class="group grid items-stretch overflow-hidden bg-app-surface md:grid-cols-2"
							>
								{featuredPost.data.heroImage ? (
									<div class="overflow-hidden">
										<img
											src={featuredPost.data.heroImage}
											alt=""
											class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 md:aspect-auto"
										/>
									</div>
								) : (
									<div class="flex aspect-[4/3] w-full items-center justify-center bg-app-accent-soft font-serif text-4xl text-app-accent/50 md:aspect-auto">
										{featuredPost.data.title.slice(0, 1)}
									</div>
								)}
								<div class="flex flex-col items-center justify-center bg-app-accent-soft p-8 text-center md:p-12 lg:p-16">
									<p class="mb-4 text-xs font-medium uppercase tracking-[0.2em] text-app-gray-500">
										精選文章
									</p>
									<h2 class="font-serif text-2xl font-semibold leading-snug tracking-tight text-app-text md:text-3xl">
										{featuredPost.data.title}
									</h2>
									<p class="mt-4 text-sm leading-relaxed text-app-gray-600 md:text-base">
										{featuredPost.data.description}
									</p>
									<span class="mt-6 border-b border-app-text pb-1 text-xs font-medium uppercase tracking-[0.15em] text-app-text">
										閱讀全文
									</span>
								</div>
							</a>
						</div>
					</section>
				)
			}

			{
				categoryTiles.length > 0 && (
					<section class="px-6 pb-16 md:pb-20">
						<div class="container mx-auto max-w-5xl">
							<h2 class="mb-10 text-center font-serif text-xl font-semibold uppercase tracking-[0.15em] text-app-accent md:text-2xl">
								文章分類
							</h2>
							<div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
								{categoryTiles.map(([category, post]) => (
									<a href="/blog" class="group block text-center">
										<div class="mb-3 aspect-square w-full overflow-hidden bg-app-accent-soft">
											{post.data.heroImage ? (
												<img
													src={post.data.heroImage}
													alt=""
													class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
												/>
											) : (
												<div class="flex h-full w-full items-center justify-center font-serif text-2xl text-app-accent/50">
													{category.slice(0, 1)}
												</div>
											)}
										</div>
										<p class="text-xs font-medium uppercase tracking-[0.15em] text-app-gray-600">
											{category}
										</p>
									</a>
								))}
							</div>
						</div>
					</section>
				)
			}

			<section class="px-6 pb-16 md:pb-24">
				<div class="container mx-auto max-w-5xl">
					<div class="mb-8 flex items-center justify-between border-b border-app-gray-200 pb-4 md:mb-10">
						<h2 class="font-serif text-xl font-semibold tracking-tight text-app-text md:text-2xl">
							更多文章
						</h2>
						<a
							href="/blog"
							class="text-xs font-medium uppercase tracking-[0.15em] text-app-gray-500 transition-colors hover:text-app-text"
						>
							查看全部
						</a>
					</div>

					{
						otherPosts.length > 0 ? (
							<div class="columns-1 gap-10 md:columns-2 lg:columns-3">
								{otherPosts.map((post) => (
									<div class="mb-10 break-inside-avoid">
										<BlogCard post={post} />
									</div>
								))}
							</div>
						) : (
							<p class="text-app-gray-500">還沒有更多文章。</p>
						)
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
