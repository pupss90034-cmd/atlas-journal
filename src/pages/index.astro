---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import LatestArticles from '../components/home/LatestArticles.astro';
import PhotoGallery from '../components/home/PhotoGallery.astro';
import Consulting from '../components/home/Consulting.astro';
import Newsletter from '../components/home/Newsletter.astro';
import { getCollection } from 'astro:content';

const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';
const SITE_DESCRIPTION = siteSettings?.data.description ?? '';
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header transparent />
		<main class="flex-1">
			<Hero />
			<About />
			<LatestArticles />
			<PhotoGallery />
			<Consulting />
			<Newsletter />
		</main>
		<Footer />
	</body>
</html>
