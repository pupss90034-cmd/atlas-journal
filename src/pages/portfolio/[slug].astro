---
// 單一相簿頁：從首頁／Portfolio 的鑲嵌塊面點進來之後的「延伸」。
// 預覽只給一張代表照，這裡才把整組照片攤開。
//
// 版面刻意不用等距格線。照片依序循環套用「整幅 → 半幅 → 半幅」，
// 大小交替本身就是節奏；再加上半幅的第二張往下錯開，
// 視線會走 Z 字，不會變成掃描表格。
import { type CollectionEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
	const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
	return albums.map((album, i) => ({
		params: { slug: album.id },
		props: {
			album,
			index: i,
			total: albums.length,
			prev: i > 0 ? albums[i - 1] : albums[albums.length - 1],
			next: i < albums.length - 1 ? albums[i + 1] : albums[0],
		},
	}));
}

type Props = {
	album: CollectionEntry<'albums'>;
	index: number;
	total: number;
	prev: CollectionEntry<'albums'>;
	next: CollectionEntry<'albums'>;
};

const { album, index, total, prev, next } = Astro.props;
const { label, images } = album.data;
const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';
const description = `${label}，共 ${images.length} 張照片。`;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`${label} — ${SITE_TITLE}`} description={description} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			<!-- 章名頁：中軸，標示這是第幾組主題 -->
			<section class="page-wide pb-14 pt-44 md:pb-20 md:pt-56">
				<div class="axis">
					<p class="label">
						Series {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
					</p>
					<h1 class="title-display mt-9 text-app-ink">{label}</h1>
					<p class="label mt-9">{String(images.length).padStart(2, '0')} Photographs</p>
				</div>
			</section>

			<!-- 圖版：微灰區帶，照片浮在紙上 -->
			<section class="band-tint page-narrow band">
				<div class="plates">
					{
						images.map((photo, i) => (
							<figure class:list={['plate', i % 3 === 0 ? 'plate-full' : 'plate-half']}>
								<Image
									src={photo.src}
									alt={photo.alt}
									class="w-full"
									widths={[600, 1000, 1600]}
									sizes={i % 3 === 0 ? '(min-width: 768px) 72rem, 100vw' : '(min-width: 768px) 36rem, 100vw'}
								/>
								{photo.alt && <figcaption class="label mt-5">{photo.alt}</figcaption>}
							</figure>
						))
					}
				</div>
			</section>

			<!-- 上下一組主題 -->
			<nav class="page-wide band-tight">
				<div class="mx-auto flex max-w-5xl items-baseline justify-between gap-8 border-t border-app-gray-200 pt-10">
					<a href={`/portfolio/${prev.id}/`} class="group block transition-opacity duration-500 hover:opacity-55">
						<p class="label">Previous Series</p>
						<p class="title-sm mt-4 text-app-ink">{prev.data.label}</p>
					</a>
					<a href={`/portfolio/${next.id}/`} class="group block text-right transition-opacity duration-500 hover:opacity-55">
						<p class="label">Next Series</p>
						<p class="title-sm mt-4 text-app-ink">{next.data.label}</p>
					</a>
				</div>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.plates {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.5rem, 4vw, 4rem) clamp(0.75rem, 2vw, 2rem);
		align-items: start;
	}
	.plate {
		margin: 0;
	}
	/* 整幅：橫跨兩欄，當作每一輪的視覺入口 */
	.plate-full {
		grid-column: 1 / -1;
	}
	/* 半幅的第二張往下錯開，讓左右兩欄不齊頭 */
	@media (min-width: 640px) {
		.plate-half:nth-of-type(3n) {
			margin-top: clamp(2.5rem, 6vw, 6rem);
		}
	}
	@media (max-width: 639px) {
		.plate-half {
			grid-column: 1 / -1;
		}
	}
</style>
