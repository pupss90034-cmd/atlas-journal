---
// 單一相簿頁：從首頁／Portfolio 的鑲嵌塊面點進來之後的「延伸」。
// 預覽只給一張代表照，這裡才把整組照片攤開。
//
// 版面刻意不用等距格線。照片依序循環套用「整幅 → 半幅 → 半幅」，
// 大小交替本身就是節奏；再加上半幅的第二張往下錯開，
// 視線會走 Z 字，不會變成掃描表格。
//
// 2026-08-07：以上說的是預設的「鑲嵌」版型。相簿檔 frontmatter 若寫
// `layout: 翻頁`，就改用 AlbumSpreads 元件——一次一張、左右翻頁、
// 不顯示圖說。那是給已經排好版、說明文字印在圖上的攝影集用的，
// 那種圖再錯落擺或再補一行圖說都只會打架。
import { type CollectionEntry, getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AlbumSpreads from '../../components/AlbumSpreads.astro';

export async function getStaticPaths() {
	const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
	return albums.map((album, i) => ({
		params: { slug: album.id },
		props: {
			album,
			index: i,
			total: albums.length,
			prev: i > 0 ? albums[i - 1] : albums[albums.length - 1],
			next: i < albums.length - 1 ? albums[i + 1] : albums[0],
		},
	}));
}

type Props = {
	album: CollectionEntry<'albums'>;
	index: number;
	total: number;
	prev: CollectionEntry<'albums'>;
	next: CollectionEntry<'albums'>;
};

const { album, index, total, prev, next } = Astro.props;
const { label, images, layout } = album.data;
const isSpreadLayout = layout === '翻頁';
const [siteSettings] = await getCollection('siteSettings');
const SITE_TITLE = siteSettings?.data.title ?? '';
const description = `${label}，共 ${images.length} 張照片。`;
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={`${label} — ${SITE_TITLE}`} description={description} />
	</head>
	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header />
		<main class="flex-1">
			{/* 章名頁：中軸，標示這是第幾組主題。
			    2026-08-09：標題從 .title-display（最大 88px）降到 .title-h1。
			    相簿名是中文，中文字在同樣的 px 下比英文佔的面積大得多，
			    88px 的中文標題會直接吃掉半個螢幕；而且這一頁的主角是照片，
			    標題只需要「說清楚這是哪一組」，不需要自己變成一件作品。 */}
			<section class="page-wide pb-12 pt-40 md:pb-16 md:pt-52">
				<div class="axis">
					<p class="label">
						Series {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
					</p>
					<h1 class="title-h1 mt-7 text-app-ink">{label}</h1>
					<p class="label mt-7">
						{String(images.length).padStart(2, '0')}
						{isSpreadLayout ? ' Pages' : ' Photographs'}
					</p>
				</div>
			</section>

			<!-- 圖版：微灰區帶，照片浮在紙上 -->
			<section class="band-tint page-narrow band">
				{
					isSpreadLayout ? (
						/* 翻頁版型：一次一張，圖說不顯示（說明已排在圖裡） */
						<AlbumSpreads images={images} />
					) : (
						<div class="plates">
							{images.map((photo, i) => (
								<figure class:list={['plate', i % 3 === 0 ? 'plate-full' : 'plate-half']}>
									<Image
										src={photo.src}
										alt={photo.alt}
										class="plate-img"
										widths={[600, 1000, 1600]}
										sizes={
											i % 3 === 0 ? '(min-width: 768px) 52rem, 100vw' : '(min-width: 768px) 26rem, 100vw'
										}
									/>
									{/* 圖說是次要文字：13px，不套 label 的大字距全大寫 */}
									{photo.alt && <figcaption class="caption mt-4">{photo.alt}</figcaption>}
								</figure>
							))}
						</div>
					)
				}
			</section>

			{/* 上下一組主題：圖示化 ─────────────────────────────
			    2026-08-07 改：原本兩側各一段「Previous Series ＋ 相簿名稱」的
			    文字堆，攤在照片看完之後的位置，讀起來像是又開始了一段文案。
			    這裡只需要「往前 / 往後」這一個動作，用箭頭表達就夠了；
			    中間留一組頁碼指出在整本裡的位置。相簿名稱移到 title 提示，
			    滑過去才出現，不佔版面。
			    （這裡用大括號註解而不是 HTML 註解，說明才不會被送到瀏覽器。） */}
			<nav class="page-wide band-tight" aria-label="攝影集導覽">
				<div class="mx-auto flex max-w-5xl items-center justify-between gap-8 border-t border-app-gray-200 pt-10">
					<a
						href={`/portfolio/${prev.id}/`}
						class="nav-icon"
						title={prev.data.label}
						aria-label={`上一組：${prev.data.label}`}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 L7 12 L15 20" /></svg>
					</a>

					<p class="label">
						{String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
					</p>

					<a
						href={`/portfolio/${next.id}/`}
						class="nav-icon"
						title={next.data.label}
						aria-label={`下一組：${next.data.label}`}
					>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 L17 12 L9 20" /></svg>
					</a>
				</div>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ── 照片尺寸（2026-08-09 重做）─────────────────────────
	   舊做法：圖片一律 width: 100%，高度由比例決定。
	   橫幅照片這樣沒問題，但直幅照片一被拉到整欄寬，高度就會
	   衝到 1.5 個視窗那麼高——讀者在螢幕上永遠看不到一張完整的
	   直幅照片，只能一段一段往下捲。

	   新做法：改用「高度」當作限制條件，寬度自己去對應。
	   每一張照片都保證能完整放進一個螢幕裡：

	     整幅 plate-full  最高 72vh   每一輪的視覺入口
	     半幅 plate-half  最高 52vh   比整幅小一階，形成節奏

	   直幅照片會因此自動變窄（高度撞到上限，寬度按比例縮），
	   橫幅照片則多半用滿欄寬——這正是實體攝影集在一頁上
	   同時排橫幅與直幅時的處理方式：對齊的是高度，不是寬度。

	   另外拿掉了原本半幅第二張往下錯開的設定。照片已經有
	   大小差異當節奏了，再加錯落只會讓「哪兩張是一組」讀不出來。 */
	.plates {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 4.5vw, 4rem) clamp(1rem, 2.5vw, 2.25rem);
		align-items: start;
	}
	.plate {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.plate-img {
		width: auto;
		max-width: 100%;
		height: auto;
	}

	/* 整幅：橫跨兩欄，當作每一輪的視覺入口 */
	.plate-full {
		grid-column: 1 / -1;
	}
	@media (min-width: 640px) {
		.plate-full .plate-img {
			max-height: 72vh;
		}
		.plate-half .plate-img {
			max-height: 52vh;
		}
	}
	/* 手機：一欄到底。螢幕本來就窄，直幅照片同樣鎖高度，
	   確保一張照片不會需要捲兩次才看得完。 */
	@media (max-width: 639px) {
		.plate-half {
			grid-column: 1 / -1;
		}
		.plate-img {
			max-height: 74vh;
		}
	}

	/* 導覽箭頭：細線描邊、無填色，跟全站 1px 灰線同一個粗細語言。
	   點擊區域用 padding 撐到 44px 以上，手機才點得到。 */
	.nav-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem;
		margin: -0.75rem;
		color: var(--color-app-gray-400);
		transition: color 0.4s ease, transform 0.4s ease;
	}
	.nav-icon svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		stroke-linecap: square;
		stroke-linejoin: miter;
	}
	.nav-icon:hover {
		color: var(--color-app-ink);
	}
	/* hover 時箭頭往它指的方向挪一點，動作本身就是提示 */
	.nav-icon:first-of-type:hover {
		transform: translateX(-0.25rem);
	}
	.nav-icon:last-of-type:hover {
		transform: translateX(0.25rem);
	}
</style>
