---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getSortedPosts } from '../utils/posts';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import defaultCover from '../assets/site/default-cover.jpg';
import { resolveHeroImage } from '../utils/heroImage';

type Props = CollectionEntry<'blog'>['data'] & { slug: string };

const { title, description, pubDate, updatedDate, heroImage, tags, slug } = Astro.props;
const displayHero = resolveHeroImage(heroImage) ?? defaultCover;

// ── 上一篇／下一篇：只在「同系列」內走 ─────────────────────
// 2026-08-07 改：原本是全站按日期串成一條線，於是「露營車指南」的下一篇
// 可能是一篇法國飲食隨筆——兩篇之間沒有任何關係，這個連結等於沒有作用。
// 現在系列＝文章所在的資料夾（Obsidian 裡怎麼分，這裡就怎麼算），
// 只在同一個資料夾內找前後篇；同系列沒有鄰居就整個區塊不顯示，
// 不回退到全站，寧可沒有連結也不要給一個假的關聯。
// slug 可能沒有：/about 也共用這個 layout，它不是文章、沒有前後篇。
const seriesOf = (id?: string) => (id && id.includes('/') ? id.split('/')[0] : '');
const currentSeries = seriesOf(slug);

// 沒有系列（文章直接放在 blog 根目錄）或不是文章時，一律不顯示前後篇：
// 「根目錄的所有散篇」不構成一個系列，把它們串起來只是另一種假關聯。
const allPosts = currentSeries ? await getSortedPosts() : [];
// 同系列、依日期由新到舊（getSortedPosts 已排好，filter 不會打亂順序）
const seriesPosts = allPosts.filter((p) => seriesOf(p.id) === currentSeries);
const currentIndex = seriesPosts.findIndex((p) => p.id === slug);
const olderPost =
	currentIndex > -1 && currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;
const newerPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;

// 改版重點（2026-08-04）：
// 標題不再壓在照片上。壓字必須加深色遮罩，遮罩會毀掉照片；
// 改成「滿版照片 →（翻頁）→ 白紙上的中軸標題頁 → 內文」，
// 這是攝影集書冊的標準順序，照片與文字各自完整。
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="flex min-h-screen flex-col bg-app-body text-app-text">
		<Header transparent />
		<main class="flex-1">
			<!-- 滿版：照片單獨佔一屏，不加任何文字與遮罩 -->
			<figure class="m-0 h-[78svh] min-h-[420px] w-full overflow-hidden bg-app-gray-100">
				<Image src={displayHero} alt="" class="h-full w-full object-cover" />
			</figure>

			<!-- 標題頁：寬邊＋中軸 -->
			<header class="page-wide pb-16 pt-20 md:pb-24 md:pt-28">
				<div class="axis">
					<p class="label">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span> · Updated <FormattedDate date={updatedDate} /></span>
						)}
					</p>
					<h1 class="title-lg mx-auto mt-9 max-w-[24ch] text-app-ink">
						{title}
					</h1>
					{description && (
						<p class="body-small mx-auto mt-8 max-w-[40ch]">{description}</p>
					)}
				</div>
			</header>

			<!-- 內文：寬邊，行長鎖在 measure，段落樣式全站統一 -->
			<article class="page-wide pb-24 md:pb-32">
				<!-- measure = 680px ≈ 65 字符（中文約 30–50 字／行） -->
				<div class="measure">
					<hr class="rule mb-16 md:mb-20" />

					<div class="prose">
						<slot />
					</div>

					{
						tags && tags.length > 0 && (
							<div class="mt-16 flex flex-wrap gap-x-6 gap-y-2 border-t border-app-gray-200 pt-8">
								{tags.map((tag) => (
									<a href={`/blog?tag=${encodeURIComponent(tag)}`} class="label link-underline">
										{tag}
									</a>
								))}
							</div>
						)
					}

					{
						/* 只有同系列真的有前後篇時才出現。單篇成立的文章（沒有系列，
						   或系列裡只有這一篇）下方就直接結束，不放空欄位。 */
						(olderPost || newerPost) && (
							<nav class="mt-20 border-t border-app-gray-200 pt-12 md:mt-28">
								{currentSeries && (
									<p class="label mb-10 text-center">{currentSeries}</p>
								)}
								<div class="grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
									{olderPost && (
										<a
											href={`/blog/${olderPost.id}/`}
											class="group block transition-opacity duration-500 hover:opacity-55"
										>
											<p class="label">← 系列前一篇</p>
											<p class="title-sm mt-4 text-app-ink">{olderPost.data.title}</p>
										</a>
									)}
									{newerPost && (
										<a
											href={`/blog/${newerPost.id}/`}
											class="group block transition-opacity duration-500 hover:opacity-55 md:col-start-2 md:text-right"
										>
											<p class="label">系列後一篇 →</p>
											<p class="title-sm mt-4 text-app-ink">{newerPost.data.title}</p>
										</a>
									)}
								</div>
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
