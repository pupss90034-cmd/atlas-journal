---
// 攝影集「雜誌翻頁」元件：一次只顯示一個主題（相簿），
// 用左右箭頭（或滑動 / 鍵盤左右鍵）切換到上一個/下一個主題。
//
// 首頁「精選攝影集」區塊與 /portfolio 攝影集頁共用這個元件，
// 資料來源都是 src/content/編輯/攝影集/ 底下的相簿檔案，
// 兩個地方顯示的主題與順序永遠一致，Obsidian 只要改一份就好。
//
// 改版重點（2026-08-04）：
// 1. 圖片格線的間距（gutter）統一成一個值 --gutter，所有圖片之間
//    等距，不再有 gap-3 / gap-4 兩種尺寸——這是「邊等距」的做法。
// 2. 圓形箭頭鈕改成純文字 Prev / Next，並移到與標題同一條基線上。
//    圓形按鈕＋陰影是網頁介面的語彙，書冊版面不用它。
// 3. 移除圖片底下的灰色佔位色塊與所有圓角。
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	albums: CollectionEntry<'albums'>[];
}

const { albums } = Astro.props;
const total = albums.length;
---

<div class="flipbook" data-total={total}>
	<!-- 標題列：左為主題名稱，右為編號與翻頁，共用同一條基線 -->
	<div class="mb-8 flex items-baseline justify-between gap-8 border-b border-app-gray-200 pb-6 md:mb-10">
		<h3 class="flipbook-label title-lg min-w-0 truncate text-app-ink">
			{albums[0]?.data.label}
		</h3>

		<div class="flex shrink-0 items-baseline gap-6">
			<p class="label">
				<span class="flipbook-counter-current">01</span>&nbsp;/&nbsp;{String(total).padStart(2, '0')}
			</p>
			<div class="flex items-baseline gap-4">
				<button type="button" class="flipbook-prev label flipbook-arrow" aria-label="上一組主題">Prev</button>
				<button type="button" class="flipbook-next label flipbook-arrow" aria-label="下一組主題">Next</button>
			</div>
		</div>
	</div>

	<div class="flipbook-stage relative">
		<button type="button" class="flipbook-prev flipbook-edge flipbook-edge-left" aria-label="上一組主題">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
				<path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>

		{
			albums.map((album, albumIndex) => (
				<div
					class="flipbook-page flipbook-grid"
					data-index={albumIndex}
					data-label={album.data.label}
					hidden={albumIndex !== 0}
				>
					{album.data.images.map((photo, photoIndex) => (
						<figure
							class:list={[
								'flipbook-cell group m-0 overflow-hidden',
								photoIndex === 0 ? 'flipbook-cell-lead' : '',
							]}
						>
							<Image
								src={photo.src}
								alt={photo.alt}
								class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
								widths={photoIndex === 0 ? [500, 800, 1100] : [300, 500]}
								sizes={photoIndex === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
							/>
						</figure>
					))}
				</div>
			))
		}

		<button type="button" class="flipbook-next flipbook-edge flipbook-edge-right" aria-label="下一組主題">
			<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none">
				<path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
	</div>
</div>

<style>
	/* 邊等距：整組照片只有一個間距值，橫向與縱向相同 */
	.flipbook {
		--gutter: clamp(0.5rem, 1.2vw, 1rem);
	}

	.flipbook-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--gutter);
	}
	@media (min-width: 768px) {
		.flipbook-grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	.flipbook-cell {
		aspect-ratio: 1 / 1;
	}
	/* 主圖：佔 2×2，成為每一頁的視覺重心 */
	.flipbook-cell-lead {
		grid-column: span 2;
		grid-row: span 2;
	}

	/* 翻頁鍵：純文字，hover 只變濃淡 */
	.flipbook-arrow {
		color: var(--color-app-gray-400);
		transition: color 0.4s ease;
	}
	.flipbook-arrow:hover {
		color: var(--color-app-ink);
	}

	/* 邊緣熱區：只是一個很淡的箭頭，沒有底色與陰影，
	   滑到照片上才浮現，不跟照片搶注意力。 */
	.flipbook-edge {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		align-items: center;
		justify-content: center;
		height: 4rem;
		width: 2.5rem;
		color: #ffffff;
		mix-blend-mode: difference;
		opacity: 0;
		transition: opacity 0.5s ease;
		z-index: 10;
	}
	.flipbook-stage:hover .flipbook-edge,
	.flipbook-edge:focus-visible {
		opacity: 0.9;
	}
	.flipbook-edge-left {
		left: 0;
	}
	.flipbook-edge-right {
		right: 0;
	}
	@media (max-width: 767px) {
		.flipbook-edge {
			opacity: 0.9;
		}
	}

	/* 翻頁：淡入淡出，不做位移，維持書頁翻開的安靜感 */
	.flipbook-page {
		animation: flipbook-fade-in 0.6s ease both;
	}
	@keyframes flipbook-fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	.flipbook-page[data-leaving='true'] {
		animation: flipbook-fade-out 0.2s ease both;
	}
	@keyframes flipbook-fade-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.flipbook-page,
		.flipbook-page[data-leaving='true'] {
			animation: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLDivElement>('.flipbook').forEach((flipbook) => {
		const pages = Array.from(flipbook.querySelectorAll<HTMLDivElement>('.flipbook-page'));
		const total = pages.length;
		if (total === 0) return;

		const counter = flipbook.querySelector<HTMLSpanElement>('.flipbook-counter-current');
		const label = flipbook.querySelector<HTMLHeadingElement>('.flipbook-label');
		const prevButtons = flipbook.querySelectorAll<HTMLButtonElement>('.flipbook-prev');
		const nextButtons = flipbook.querySelectorAll<HTMLButtonElement>('.flipbook-next');

		let current = 0;

		function render(nextIndex: number) {
			const outgoing = pages[current];
			outgoing.dataset.leaving = 'true';
			window.setTimeout(() => {
				pages.forEach((page, i) => {
					page.hidden = i !== nextIndex;
					delete page.dataset.leaving;
				});
			}, 180);

			current = nextIndex;
			const page = pages[current];
			if (counter) counter.textContent = String(current + 1).padStart(2, '0');
			if (label) label.textContent = page.dataset.label ?? '';
		}

		function goTo(delta: number) {
			const next = (current + delta + total) % total;
			render(next);
		}

		prevButtons.forEach((btn) => btn.addEventListener('click', () => goTo(-1)));
		nextButtons.forEach((btn) => btn.addEventListener('click', () => goTo(1)));

		// 鍵盤左右鍵：只有當這個攝影集區塊在畫面上時才會反應，
		// 避免跟其他頁面元件（例如表單輸入）互相干擾。
		function inViewport() {
			const rect = flipbook.getBoundingClientRect();
			return rect.top < window.innerHeight && rect.bottom > 0;
		}
		document.addEventListener('keydown', (e) => {
			if (!inViewport()) return;
			const target = e.target as HTMLElement | null;
			if (target && ['INPUT', 'TEXTAREA'].includes(target.tagName)) return;
			if (e.key === 'ArrowLeft') goTo(-1);
			if (e.key === 'ArrowRight') goTo(1);
		});

		// 手機滑動翻頁
		let touchStartX = 0;
		const stage = flipbook.querySelector<HTMLDivElement>('.flipbook-stage');
		stage?.addEventListener('touchstart', (e) => {
			touchStartX = e.touches[0].clientX;
		}, { passive: true });
		stage?.addEventListener('touchend', (e) => {
			const delta = e.changedTouches[0].clientX - touchStartX;
			if (Math.abs(delta) < 40) return;
			goTo(delta < 0 ? 1 : -1);
		}, { passive: true });
	});
</script>
