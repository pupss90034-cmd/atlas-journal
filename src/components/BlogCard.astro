---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import defaultCover from '../assets/site/default-cover.jpg';
import { resolveHeroImage } from '../utils/heroImage';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage } = post.data;
const cover = resolveHeroImage(heroImage) ?? defaultCover;

// 改版重點：不再是「卡片」。沒有外框、沒有底色、沒有標籤藥丸，
// 就是一張圖版加下方的圖說（日期 / 標題 / 一句話），
// 排版邏輯與攝影集圖說完全一致。
//
// 2026-08-07：比例由 4:5 直幅改回 3:2 橫幅。
// 直幅在總覽頁佔的垂直高度太大，一屏只讀得到兩篇，整頁變成翻不完的圖牆；
// 這裡的圖是「索引」不是「作品」，作品要看完整的請進攝影集頁。
// 橫幅同時讓文字圖說更靠近圖片，一組就是一個可掃視的單位。
---

<a href={`/blog/${post.id}/`} class="group block">
	<article>
		<div class="aspect-[3/2] w-full overflow-hidden bg-app-gray-100">
			<Image
				src={cover}
				alt=""
				class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
				widths={[400, 600, 900]}
				sizes="(min-width: 768px) 26rem, 92vw"
			/>
		</div>

		{/* 層級：MICRO 日期 → H3 篇名 → SMALL 摘要。
		    篇名固定 H3，不隨欄寬改變——同一頁的所有篇名一樣大，
		    讀者才不會誤以為字比較大的那篇比較重要。 */}
		<div class="mt-5 transition-opacity duration-500 group-hover:opacity-60">
			<p class="label">
				<FormattedDate date={pubDate} />
			</p>
			<h3 class="title-h3 mt-3 max-w-[24ch] text-app-ink">
				{title}
			</h3>
			<p class="body-small mt-3 line-clamp-2 max-w-[38ch]">
				{description}
			</p>
		</div>
	</article>
</a>
