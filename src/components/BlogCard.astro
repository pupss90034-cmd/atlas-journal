---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import defaultCover from '../assets/site/default-cover.jpg';
import { resolveHeroImage } from '../utils/heroImage';
import { getCategory, getReadingMinutes } from '../utils/posts';
import { titleFitEm } from '../utils/titleFit';

// ── 2026-08-17：改成「一個元件、兩種版型」──────────────────────
// 參考 quietpages 的 PostCard。它的作法是同一份資料在不同頁面用不同
// 排法，但**眉標、標題、摘要、meta 的順序永遠一樣**——讀者在首頁學會
// 怎麼讀一張卡片之後，到了 Archive 頁不用重學。
//
//   variant="grid"（首頁 Latest 三欄格線）
//     圖在上（16:10）→ 分類 · 日期 → 篇名 → 摘要兩行 → 閱讀時間
//
//   variant="list"（/blog Archive 一列一篇）
//     文字在左、方形縮圖在右 → 分類 · 日期 → 篇名 → 摘要 → 閱讀時間
//
// 兩種版型的資訊順序相同，差別只有「圖放哪裡、字多大」。
//
// data-* 屬性是給 /blog 的搜尋與篩選用的（篩選是前端跑的，
// 靠這幾個屬性決定一張卡片要不要顯示），首頁的分類篩選也共用同一組。

interface Props {
	post: CollectionEntry<'blog'>;
	variant?: 'grid' | 'list';
	showReadingTime?: boolean;
	hidden?: boolean;
}

const { post, variant = 'grid', showReadingTime = true, hidden = false } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const cover = resolveHeroImage(heroImage) ?? defaultCover;
const category = getCategory(post);
const minutes = getReadingMinutes(post);
// 篇名一律只顯示一行，字級自動縮到放得下（見 global.css 的 .title-fit）
const fit = titleFitEm(title);

// 搜尋用的字串：篇名 ＋ 摘要 ＋ 分類 ＋ 標籤，全部轉小寫先算好，
// 瀏覽器那邊每按一個鍵只要做一次 includes()，不用重組字串。
const searchable = [title, description, category, ...(tags ?? [])].join(' ').toLowerCase();
---

{
	variant === 'list' ? (
		<article
			class="group grid grid-cols-1 gap-x-10 gap-y-5 border-b border-app-gray-200 py-9 sm:grid-cols-[minmax(0,1fr)_13.75rem] md:py-11"
			data-post-card
			data-category={category}
			data-tags={(tags ?? []).join('|').toLowerCase()}
			data-search={searchable}
			hidden={hidden}
		>
			<div class="fit-box order-2 sm:order-1">
				<p class="label">
					{category && (
						<>
							{category}
							<span class="mx-1.5 text-app-gray-300">·</span>
						</>
					)}
					<FormattedDate date={pubDate} />
				</p>
				<a href={`/blog/${post.id}/`} class="mt-3 block">
					<h2
						class="title-h3 title-fit title-fit-h3 text-app-ink transition-opacity duration-500 group-hover:opacity-60"
						style={`--fit:${fit}`}
					>
						{title}
					</h2>
				</a>
				<p class="body-small mt-3 line-clamp-2 max-w-[46ch]">{description}</p>
				{showReadingTime && <p class="label mt-5">{minutes} MIN READ</p>}
			</div>

			<a href={`/blog/${post.id}/`} class="order-1 block sm:order-2" aria-label={`閱讀：${title}`}>
				<div class="aspect-[3/2] w-full overflow-hidden bg-app-gray-100 sm:aspect-square">
					<Image
						src={cover}
						alt=""
						class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
						widths={[280, 440, 660]}
						sizes="(min-width: 640px) 13.75rem, 92vw"
					/>
				</div>
			</a>
		</article>
	) : (
		<article
			class="group"
			data-post-card
			data-category={category}
			data-tags={(tags ?? []).join('|').toLowerCase()}
			data-search={searchable}
			hidden={hidden}
		>
			<a href={`/blog/${post.id}/`} class="block" aria-label={`閱讀：${title}`}>
				<div class="aspect-[16/10] w-full overflow-hidden bg-app-gray-100">
					<Image
						src={cover}
						alt=""
						class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
						widths={[320, 480, 720]}
						sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 92vw"
					/>
				</div>
			</a>

			<div class="fit-box mt-5 transition-opacity duration-500 group-hover:opacity-60">
				<p class="label">
					{category && (
						<>
							{category}
							<span class="mx-1.5 text-app-gray-300">·</span>
						</>
					)}
					<FormattedDate date={pubDate} />
				</p>
				<a href={`/blog/${post.id}/`} class="mt-3 block">
					<h3 class="title-h4 title-fit title-fit-h4 text-app-ink" style={`--fit:${fit}`}>
						{title}
					</h3>
				</a>
				<p class="body-small mt-3 line-clamp-2">{description}</p>
				{showReadingTime && <p class="label mt-4">{minutes} MIN READ</p>}
			</div>
		</article>
	)
}
