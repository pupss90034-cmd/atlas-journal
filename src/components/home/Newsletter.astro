---
import { getCollection } from 'astro:content';
import { parseEditableBlock } from '../../utils/editableBody';

// 版面：寬邊＋中軸，白底。
// 原本是整塊深色底＋實心按鈕，那個對比會把視線從照片上搶走。
// 改成白紙上的一條輸入線——欄位只有底線，送出鍵是純文字。
//
// 2026-08-10：這一區的所有文字（標題、標題下方的短介紹、輸入框提示、
// 送出鍵字樣、最下面的隱私說明）原本全部寫死在這個檔案裡，
// 在 Obsidian 完全改不到。現在搬到「編輯/首頁-電子報.md」。
const [entry] = await getCollection('homeNewsletter');
if (!entry) {
	throw new Error('找不到「首頁-電子報.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, heading, placeholder, buttonLabel, privacyNote } = entry.data;
// 內文第一個 ## 之前的段落 ＝ 標題下方那段短介紹
const { intro } = parseEditableBlock(entry.body);
---

<section id="newsletter" class="band-tint page-wide band">
	<div class="axis">
		<p class="label">{eyebrow}</p>
		<h2 class="title-h2 title-caps mt-5 text-app-ink">{heading}</h2>
		<p class="body-small mx-auto mt-6 max-w-[38ch]">
			{intro}
		</p>

		<form id="newsletter-form" class="mx-auto mt-14 flex max-w-md items-baseline gap-6 border-b border-app-gray-400 pb-4" novalidate>
			<!-- Honeypot field: hidden from real visitors, catches simple bots. -->
			<div class="absolute -left-[9999px]" aria-hidden="true">
				<label for="company">請勿填寫</label>
				<input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
			</div>

			<input
				type="email"
				name="email"
				id="newsletter-email"
				required
				placeholder={placeholder}
				class="w-full flex-1 bg-transparent text-left text-lg text-app-ink placeholder:text-app-gray-300 focus:outline-none"
			/>
			<button
				type="submit"
				id="newsletter-submit"
				data-label={buttonLabel}
				class="label link-underline shrink-0 whitespace-nowrap text-app-ink disabled:opacity-40"
			>
				{buttonLabel}
			</button>
		</form>

		<p id="newsletter-message" class="body-small mt-6 min-h-[1.25rem] text-xs" role="status" aria-live="polite"></p>

		<p class="mx-auto mt-8 max-w-[44ch] text-[11px] leading-relaxed text-app-gray-400">
			{privacyNote}
		</p>
	</div>
</section>

<script>
	const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
	const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
	const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
	const message = document.getElementById('newsletter-message');

	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	// 單色系統裡不用綠／紅來區分狀態，改用「深墨（有結果）／淡灰（無事）」
	function setMessage(text: string, tone: 'success' | 'error' | 'muted') {
		if (!message) return;
		message.textContent = text;
		message.classList.remove('text-app-ink', 'text-app-gray-400');
		if (tone === 'muted') message.classList.add('text-app-gray-400');
		else message.classList.add('text-app-ink');
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const email = emailInput?.value.trim() ?? '';

		if (!EMAIL_RE.test(email)) {
			setMessage('請輸入正確格式的電子信箱。', 'error');
			emailInput?.focus();
			return;
		}

		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = '送出中…';
		}
		setMessage('', 'muted');

		try {
			const formData = new FormData(form);
			const res = await fetch('/api/subscribe', {
				method: 'POST',
				body: formData,
			});
			const data: { ok: boolean; alreadySubscribed?: boolean; error?: string } = await res.json();

			if (data.ok) {
				setMessage(
					data.alreadySubscribed ? '這個信箱已經訂閱過囉，謝謝你！' : '訂閱成功！之後有新文章會寄信通知你。',
					'success',
				);
				form.reset();
			} else if (data.error === 'INVALID_EMAIL') {
				setMessage('請輸入正確格式的電子信箱。', 'error');
			} else {
				setMessage('訂閱失敗，請稍後再試一次。', 'error');
			}
		} catch {
			setMessage('網路連線異常，請稍後再試一次。', 'error');
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				// 送出後把字樣還原成你在「首頁-電子報.md」設定的那個，
				// 而不是寫死的「訂閱」——以前這裡按一次就會從 Subscribe 變成訂閱。
				submitBtn.textContent = submitBtn.dataset.label ?? 'Subscribe';
			}
		}
	});
</script>
