---
---

<section id="newsletter" class="bg-app-ink px-6 py-20 md:py-28">
	<div class="mx-auto max-w-xl text-center">
		<p class="text-xs font-medium uppercase tracking-[0.3em] text-app-body/60">Newsletter</p>
		<h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-app-body md:text-4xl">
			訂閱電子報
		</h2>
		<p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-app-body/70 md:text-base">
			每次發佈新文章或新攝影集，第一時間寄到你的信箱，不定期分享路上的私房清單。
		</p>

		<form id="newsletter-form" class="mt-9 flex flex-col gap-3 sm:flex-row sm:gap-0" novalidate>
			<!-- Honeypot field: hidden from real visitors, catches simple bots. -->
			<div class="absolute -left-[9999px]" aria-hidden="true">
				<label for="company">請勿填寫</label>
				<input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
			</div>

			<input
				type="email"
				name="email"
				id="newsletter-email"
				required
				placeholder="你的電子信箱"
				class="w-full flex-1 border border-app-body/25 bg-transparent px-5 py-3.5 text-sm text-app-body placeholder:text-app-body/50 focus:border-app-body/60 focus:outline-none sm:border-r-0"
			/>
			<button
				type="submit"
				id="newsletter-submit"
				class="shrink-0 whitespace-nowrap bg-app-accent px-7 py-3.5 text-xs font-medium uppercase tracking-[0.2em] text-app-body transition-colors duration-300 hover:bg-app-accent-dark disabled:opacity-60"
			>
				訂閱
			</button>
		</form>

		<p id="newsletter-message" class="mt-4 min-h-[1.25rem] text-xs" role="status" aria-live="polite"></p>

		<p class="mt-6 text-[11px] leading-relaxed text-app-body/40">
			訂閱即表示你同意收到本站的電子報通知，我們不會分享你的信箱給第三方，取消訂閱請直接回信告知。
		</p>
	</div>
</section>

<script>
	const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
	const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
	const submitBtn = document.getElementById('newsletter-submit') as HTMLButtonElement | null;
	const message = document.getElementById('newsletter-message');

	const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	function setMessage(text: string, tone: 'success' | 'error' | 'muted') {
		if (!message) return;
		message.textContent = text;
		message.classList.remove('text-app-moss', 'text-red-400', 'text-app-body/60');
		if (tone === 'success') message.classList.add('text-app-moss');
		else if (tone === 'error') message.classList.add('text-red-400');
		else message.classList.add('text-app-body/60');
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const email = emailInput?.value.trim() ?? '';

		if (!EMAIL_RE.test(email)) {
			setMessage('請輸入正確格式的電子信箱。', 'error');
			emailInput?.focus();
			return;
		}

		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = '送出中…';
		}
		setMessage('', 'muted');

		try {
			const formData = new FormData(form);
			const res = await fetch('/api/subscribe', {
				method: 'POST',
				body: formData,
			});
			const data: { ok: boolean; alreadySubscribed?: boolean; error?: string } = await res.json();

			if (data.ok) {
				setMessage(
					data.alreadySubscribed ? '這個信箱已經訂閱過囉，謝謝你！' : '訂閱成功！之後有新文章會寄信通知你。',
					'success',
				);
				form.reset();
			} else if (data.error === 'INVALID_EMAIL') {
				setMessage('請輸入正確格式的電子信箱。', 'error');
			} else {
				setMessage('訂閱失敗，請稍後再試一次。', 'error');
			}
		} catch {
			setMessage('網路連線異常，請稍後再試一次。', 'error');
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = '訂閱';
			}
		}
	});
</script>
