---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const [aboutEntry] = await getCollection('homeAbout');
if (!aboutEntry) {
	throw new Error('找不到「首頁-關於我.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, heading, portrait, portraitAlt, ctaLabel, stats } = aboutEntry.data;
const { Content } = await render(aboutEntry);

// 版面：寬邊。緊接在滿版 Hero 之後，用大留白把視覺鬆開，
// 形成「滿版（緊）→ 寬邊（鬆）」的第一組節奏。
---

<section id="about" class="page-wide band">
	<div class="mx-auto max-w-5xl">
		<p class="label">{eyebrow}</p>

		<div class="mt-12 grid grid-cols-1 gap-x-16 gap-y-16 md:mt-16 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
			<!-- 直幅人像，固定 3:4。背後襯一塊微灰矩形只露左下一角，
			     用來製造深度——這比加陰影乾淨，也是 Tom Quan 那張範例
			     裡讓單張照片不顯得單薄的手法。 -->
			<div class="offset-plate">
				<div class="aspect-[3/4] w-full overflow-hidden">
					<Image
						src={portrait}
						alt={portraitAlt}
						class="h-full w-full object-cover"
						widths={[400, 640, 900]}
						sizes="(min-width: 768px) 420px, 90vw"
					/>
				</div>
			</div>

			<div class="flex flex-col">
				<h2 class="title-lg max-w-[20ch] text-app-ink">
					{heading}
				</h2>

				<div class="about-copy mt-9">
					<Content />
				</div>

				<div class="mt-auto pt-12">
					<div class="grid grid-cols-3 gap-8 border-t border-app-gray-200 pt-8">
						{stats.map((stat) => (
							<div>
								<p class="text-2xl text-app-ink md:text-3xl">{stat.value}</p>
								<p class="label mt-3 leading-relaxed">{stat.label}</p>
							</div>
						))}
					</div>

					<a href="/about" class="label link-underline mt-10 inline-block text-app-ink">
						{ctaLabel}
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* 同段落樣式：首頁 About 的內文與文章內文用同一套規格 */
	.about-copy :global(p) {
		font-size: 1.0625rem;
		line-height: 1.85;
		color: var(--color-app-gray-600);
		margin: 0 0 1.5em;
	}
	.about-copy :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
