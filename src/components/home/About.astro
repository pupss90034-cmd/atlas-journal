---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const [aboutEntry] = await getCollection('homeAbout');
if (!aboutEntry) {
	throw new Error('找不到「首頁-關於我.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, heading, portrait, portraitAlt, ctaLabel, stats } = aboutEntry.data;
const { Content } = await render(aboutEntry);
---

<section id="about" class="px-6 py-20 md:py-28">
	<div class="mx-auto grid max-w-5xl grid-cols-1 items-center gap-12 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-16">
		<div class="mx-auto aspect-[3/4] w-full max-w-sm overflow-hidden md:mx-0">
			<Image
				src={portrait}
				alt={portraitAlt}
				class="h-full w-full object-cover"
				widths={[400, 640, 900]}
				sizes="(min-width: 768px) 420px, 90vw"
			/>
		</div>

		<div>
			<p class="text-xs font-medium uppercase tracking-[0.3em] text-app-gray-500">{eyebrow}</p>
			<h2 class="mt-4 font-serif text-3xl font-semibold leading-tight tracking-tight text-app-ink md:text-4xl">
				{heading}
			</h2>
			<div class="about-copy mt-6 space-y-4">
				<Content />
			</div>

			<div class="mt-10 grid grid-cols-3 gap-6 border-t border-app-gray-200 pt-8">
				{stats.map((stat) => (
					<div>
						<p class="font-serif text-2xl font-semibold text-app-accent md:text-3xl">{stat.value}</p>
						<p class="mt-1.5 text-[11px] uppercase leading-snug tracking-[0.12em] text-app-gray-500 md:text-xs">
							{stat.label}
						</p>
					</div>
				))}
			</div>

			<a
				href="/about"
				class="group mt-10 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-app-ink"
			>
				<span class="border-b border-app-ink pb-1 transition-colors group-hover:border-app-accent group-hover:text-app-accent">
					{ctaLabel}
				</span>
				<span class="transition-transform group-hover:translate-x-1">⭢</span>
			</a>
		</div>
	</div>
</section>

<style>
	.about-copy :global(p) {
		font-size: 1rem;
		line-height: 1.625;
		color: var(--color-app-gray-600);
	}
	@media (min-width: 768px) {
		.about-copy :global(p) {
			font-size: 1.125rem;
		}
	}
</style>
