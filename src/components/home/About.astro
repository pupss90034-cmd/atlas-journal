---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';

const [aboutEntry] = await getCollection('homeAbout');
if (!aboutEntry) {
	throw new Error('找不到「首頁-關於我.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, portrait, portraitAlt, ctaLabel } = aboutEntry.data;
const { Content } = await render(aboutEntry);

// 版面：寬邊。緊接在滿版 Hero 之後，用大留白把視覺鬆開，
// 形成「滿版（緊）→ 寬邊（鬆）」的第一組節奏。
//
// 2026-08-09 改動兩件事：
//
// 1. 去贅字。原本這裡是「About Me」眉標＋「關於我」大標，
//    同一件事用中英文各說一次，第二次沒有帶進任何新資訊。
//    現在只留 About Me 一個標題，直接接段落。
//    heading 欄位在 Obsidian 檔案裡保留但不再顯示。
//
// 2. 拿掉數據統計（22+ 國家 / 180K 公里 / 4 年）。
//    那三個數字是網站模板的「成就欄」語彙，屬於接案作品集的
//    信任背書；一個以文字與照片為主的個人誌不需要用數字證明
//    自己，讀者也不會因為看到 180K 而更想讀文章。拿掉之後
//    這一區只剩「一張人像＋一段自我介紹＋一個連結」，
//    正好是這個區塊真正要做的事。
//    stats 欄位在 Obsidian 檔案裡保留但不再顯示。
---

<section id="about" class="page-wide band">
	<div class="mx-auto max-w-5xl">
		<div class="grid grid-cols-1 gap-x-16 gap-y-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
			<!-- 直幅人像，固定 3:4。背後襯一塊微灰矩形只露左下一角，
			     用來製造深度——這比加陰影乾淨，也是 Tom Quan 那張範例
			     裡讓單張照片不顯得單薄的手法。 -->
			<div class="offset-plate">
				<div class="aspect-[3/4] w-full overflow-hidden">
					<Image
						src={portrait}
						alt={portraitAlt}
						class="h-full w-full object-cover"
						widths={[400, 640, 900]}
						sizes="(min-width: 768px) 420px, 90vw"
					/>
				</div>
			</div>

			<!-- 層級：H2 標題 → 內文 → CTA。中間沒有第二個標題插隊。 -->
			<div class="flex flex-col">
				<h2 class="title-h2 title-caps text-app-ink">{eyebrow}</h2>

				<div class="about-copy mt-9">
					<Content />
				</div>

				<div class="mt-auto pt-12">
					<a href="/about" class="label link-underline inline-block text-app-ink">
						{ctaLabel}
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* 同段落樣式：首頁 About 的內文與文章內文用同一套規格 */
	.about-copy :global(p) {
		font-size: var(--text-body);
		line-height: var(--leading-body);
		color: var(--color-app-gray-600);
		margin: 0 0 1.5em;
		/* 行長上限：中文一行約 30–40 字，超過就不好讀 */
		max-width: 40ch;
	}
	.about-copy :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
