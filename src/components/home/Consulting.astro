---
import { getCollection } from 'astro:content';
import { parseEditableBlock } from '../../utils/editableBody';

const [consultingEntry] = await getCollection('homeConsulting');
if (!consultingEntry) {
	throw new Error('找不到「首頁-顧問服務.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, heading, description, ctaText, ctaButtonLabel } = consultingEntry.data;

// 2026-08-10：服務項目從 frontmatter 的 services 清單搬到內文。
// 原因：frontmatter 的巢狀清單在 Obsidian 裡是點不動的唯讀屬性面板，
// 要改就得切到原始碼模式跟 YAML 縮排搏鬥，縮排錯一格整站建不起來。
// 現在一個 `## 服務名稱` ＋ 一段說明就是一個項目，就是普通打字。
const { items: services } = parseEditableBlock(consultingEntry.body);

// 販售包（即將上架的內容包）：接在服務項目下面，同一區的第二段。
// 這一段對應 Obsidian 裡 blog/「Y - (販售包⋯)」那幾個資料夾正在準備的產品；
// 那些資料夾的文章本身不會發佈到 Journal，網站上只露出這裡的預告。
const [productsEntry] = await getCollection('homeProducts');
const products = productsEntry?.data.enabled ? parseEditableBlock(productsEntry.body) : null;

// 版面：寬邊＋中軸。
// 攝影集之後回到最鬆的版式收尾。服務項目原本是三個有外框的卡片，
// 外框會讓版面回到「網頁感」，這裡改成三欄純文字，只靠一條上緣細線
// 與欄距分開，維持整站「不用色塊、只用線與留白」的規則。
---

<section class="page-wide band">
	<div class="mx-auto max-w-4xl">
		<div class="axis">
			<p class="label">{eyebrow}</p>
			<h2 class="title-h2 title-caps mx-auto mt-5 max-w-[20ch] text-app-ink">
				{heading}
			</h2>
			<p class="body-small mx-auto mt-6 max-w-[38ch]">
				{description}
			</p>
		</div>

		{
			services.length > 0 && (
				<div class="mt-20 grid grid-cols-1 gap-x-12 gap-y-12 md:mt-24 md:grid-cols-3">
					{services.map((service, i) => (
						<div class="border-t border-app-gray-200 pt-7">
							<p class="label">{String(i + 1).padStart(2, '0')}</p>
							<h3 class="title-h3 mt-5 text-app-ink">{service.title}</h3>
							<p class="body-small mt-4">{service.description}</p>
						</div>
					))}
				</div>
			)
		}

		{/* 販售包：同一區的第二段，用一條細線與上面的服務項目分開。
		    刻意排在服務之後而不是另開一頁——三個包目前都還沒上架，
		    自己開一頁會是一頁空的商店，反而讓人覺得這個網站沒東西。
		    等真的上架了再抽出來做成 /shop。 */}
		{
			products && products.items.length > 0 && (
				<div class="mt-24 border-t border-app-gray-300 pt-16 md:mt-32 md:pt-20">
					<div class="axis">
						<p class="label">{productsEntry!.data.eyebrow}</p>
						<h3 class="title-h3 mx-auto mt-5 max-w-[20ch] text-app-ink">
							{productsEntry!.data.heading}
						</h3>
						{products.intro && (
							<p class="body-small mx-auto mt-5 max-w-[38ch]">{products.intro}</p>
						)}
					</div>

					<ul class="mx-auto mt-14 max-w-2xl">
						{products.items.map((product) => (
							<li class="flex flex-col gap-x-10 gap-y-2 border-t border-app-gray-200 py-6 sm:flex-row sm:items-baseline">
								<h4 class="title-h4 shrink-0 text-app-ink sm:w-[11rem]">{product.title}</h4>
								<p class="body-small">{product.description}</p>
							</li>
						))}
					</ul>
				</div>
			)
		}

		<div class="axis mt-20 md:mt-24">
			<p class="body-small">{ctaText}</p>
			<a href="#newsletter" class="label link-underline mt-7 inline-block text-app-ink">
				{ctaButtonLabel}
			</a>
		</div>
	</div>
</section>
