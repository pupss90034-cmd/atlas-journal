---
import { getCollection } from 'astro:content';

const [consultingEntry] = await getCollection('homeConsulting');
if (!consultingEntry) {
	throw new Error('找不到「首頁-顧問服務.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, heading, description, ctaText, ctaButtonLabel, services } = consultingEntry.data;

// 版面：寬邊＋中軸。
// 攝影集之後回到最鬆的版式收尾。服務項目原本是三個有外框的卡片，
// 外框會讓版面回到「網頁感」，這裡改成三欄純文字，只靠一條上緣細線
// 與欄距分開，維持整站「不用色塊、只用線與留白」的規則。
---

<section class="page-wide band">
	<div class="mx-auto max-w-4xl">
		<div class="axis">
			<p class="label">{eyebrow}</p>
			<h2 class="title-h2 title-caps mx-auto mt-5 max-w-[20ch] text-app-ink">
				{heading}
			</h2>
			<p class="body-small mx-auto mt-6 max-w-[38ch]">
				{description}
			</p>
		</div>

		<div class="mt-20 grid grid-cols-1 gap-x-12 gap-y-12 md:mt-24 md:grid-cols-3">
			{services.map((service, i) => (
				<div class="border-t border-app-gray-200 pt-7">
					<p class="label">{String(i + 1).padStart(2, '0')}</p>
					<h3 class="title-h3 mt-5 text-app-ink">{service.title}</h3>
					<p class="body-small mt-4">{service.description}</p>
				</div>
			))}
		</div>

		<div class="axis mt-20 md:mt-24">
			<p class="body-small">{ctaText}</p>
			<a href="#newsletter" class="label link-underline mt-7 inline-block text-app-ink">
				{ctaButtonLabel}
			</a>
		</div>
	</div>
</section>
