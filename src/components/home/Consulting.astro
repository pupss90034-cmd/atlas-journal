---
import { getCollection } from 'astro:content';

const [consultingEntry] = await getCollection('homeConsulting');
if (!consultingEntry) {
	throw new Error('找不到「首頁-顧問服務.md」，請確認 src/content/編輯 資料夾裡有這個檔案。');
}
const { eyebrow, heading, description, ctaText, ctaButtonLabel, services } = consultingEntry.data;
---

<section class="px-6 py-20 md:py-28">
	<div class="mx-auto max-w-5xl">
		<div class="mb-10 text-center md:mb-14">
			<p class="text-xs font-medium uppercase tracking-[0.3em] text-app-gray-500">{eyebrow}</p>
			<h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-app-ink md:text-4xl">
				{heading}
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-app-gray-600 md:text-base">
				{description}
			</p>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
			{services.map((service) => (
				<div class="group border border-app-gray-200 bg-app-surface p-8 transition-colors duration-300 hover:border-app-accent">
					<h3 class="font-serif text-xl font-semibold tracking-tight text-app-ink">{service.title}</h3>
					<p class="mt-3 text-sm leading-relaxed text-app-gray-500">{service.description}</p>
				</div>
			))}
		</div>

		<div class="mt-12 flex flex-col items-center gap-4 text-center">
			<p class="text-sm text-app-gray-600">{ctaText}</p>
			<a
				href="#newsletter"
				class="inline-flex items-center gap-2 bg-app-ink px-7 py-3.5 text-xs font-medium uppercase tracking-[0.2em] text-app-body transition-colors duration-300 hover:bg-app-accent"
			>
				{ctaButtonLabel}
			</a>
		</div>
	</div>
</section>
