---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import BlogCard from '../BlogCard.astro';
import Icon from '../Icon.astro';
import defaultCover from '../../assets/site/default-cover.jpg';
import { resolveHeroImage } from '../../utils/heroImage';
import { getSortedPosts, getCategory, getCategories, getReadingMinutes } from '../../utils/posts';
import { titleFitEm } from '../../utils/titleFit';

// ══════════════════════════════════════════════════════════════════
// 首頁文章區（2026-08-17 依 quietpages 的編排邏輯重寫）
//
// 這一區現在是兩段，跟參考網站一樣：
//
//   ① FEATURED —— 一篇頭條，左邊一張 4:3 大圖、右邊一整欄文字
//      （分類 · 日期 → 篇名 → 摘要 → 閱讀時間 → 進入文章），
//      右上角一個「All Writing →」直接通往 Archive。
//
//   ② LATEST ——  分類篩選 ＋ 三欄文章格線，最下面一顆「進入 Archive」。
//      篩選是純前端的：點一個分類，格線就地換一批，不換頁、不重新載入。
//
// 為什麼是這個順序：讀者第一次進站時最需要的是「給我一篇來讀」，
// 不是「這裡有 60 篇請自己挑」。頭條負責前者、格線負責後者。
//
// 跟參考網站不一樣的地方只有語彙：不用磚紅強調色、不用圓角藥丸按鈕，
// 維持這個網站原本的單色系統（白紙、墨字、1px 細線）與襯線字體。
//
// 這一區的所有文字都在 Obsidian 的「編輯/首頁-最新文章.md」裡改。
// ══════════════════════════════════════════════════════════════════

const [settings] = await getCollection('homeLatest');

const featuredEyebrow = settings?.data.featuredEyebrow ?? 'Featured';
const archiveLinkLabel = settings?.data.archiveLinkLabel ?? 'All Writing';
const featuredCtaLabel = settings?.data.featuredCtaLabel ?? 'Read the essay';
const eyebrow = settings?.data.eyebrow ?? 'Latest';
const heading = settings?.data.heading ?? 'From the Journal';
const ctaLabel = settings?.data.ctaLabel ?? 'Browse the Archive';
const gridCount = settings?.data.gridCount ?? 6;
const showReadingTime = settings?.data.showReadingTime ?? true;
const allLabel = settings?.data.allLabel ?? 'All';
const emptyText = settings?.data.emptyText ?? '這個分類目前還沒有文章。';

const posts = await getSortedPosts();

// 頭條：預設是最新的一篇。想固定某一篇當頭條，就在
// 「首頁-最新文章.md」的 featuredTitle 填那篇的標題（打幾個關鍵字就行，
// 用「包含」比對），找不到就自動退回最新那篇，不會壞掉。
const pinned = settings?.data.featuredTitle?.trim();
const featured =
	(pinned ? posts.find((p) => p.data.title.includes(pinned)) : undefined) ?? posts[0];

const rest = featured ? posts.filter((p) => p.id !== featured.id) : [];
const categories = getCategories(rest);

const featuredCover = featured
	? (resolveHeroImage(featured.data.heroImage) ?? defaultCover)
	: defaultCover;
const featuredCategory = featured ? getCategory(featured) : '';
const featuredMinutes = featured ? getReadingMinutes(featured) : 0;
// 頭條篇名也只顯示一行（見 global.css 的 .title-fit）
const featuredFit = featured ? titleFitEm(featured.data.title) : 12;
---

{
	featured && (
		<>
			{/* ── ① 頭條 ──────────────────────────────────────── */}
			<section
				id="latest"
				class="page-wide border-b border-app-gray-200 pb-20 pt-24 md:pb-28 md:pt-32"
			>
				<div class="mx-auto max-w-6xl">
					<div class="mb-10 flex items-baseline justify-between gap-6 md:mb-14">
						<p class="label">{featuredEyebrow}</p>
						<a href="/blog" class="label link-underline text-app-ink">
							{archiveLinkLabel} &rarr;
						</a>
					</div>

					<article class="grid grid-cols-1 items-center gap-x-16 gap-y-8 lg:grid-cols-2">
						<a
							href={`/blog/${featured.id}/`}
							class="group block"
							aria-label={`閱讀：${featured.data.title}`}
						>
							<div class="aspect-[4/3] w-full overflow-hidden bg-app-gray-100">
								<Image
									src={featuredCover}
									alt=""
									class="h-full w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
									widths={[480, 720, 1080]}
									sizes="(min-width: 1024px) 34rem, 92vw"
								/>
							</div>
						</a>

						<div class="fit-box flex flex-col justify-center">
							<p class="label">
								{featuredCategory && (
									<>
										{featuredCategory}
										<span class="mx-1.5 text-app-gray-300">·</span>
									</>
								)}
								<FormattedDate date={featured.data.pubDate} />
							</p>

							{/* 頭條篇名用 H2。這一段沒有區塊標題（只有「FEATURED」眉標），
							    所以篇名就是這一段層級最高的字，不會出現「item 比 section 還大」
							    的問題——那條規則在下面的 Latest 區仍然成立（H2 區塊標 → H4 篇名）。 */}
							<a href={`/blog/${featured.id}/`} class="mt-5 block">
								<h2
									class="title-h2 title-fit title-fit-h2 text-app-ink transition-opacity duration-500 hover:opacity-60"
									style={`--fit:${featuredFit}`}
								>
									{featured.data.title}
								</h2>
							</a>

							<p class="body-small mt-5 max-w-[42ch]">{featured.data.description}</p>

							{showReadingTime && <p class="label mt-6">{featuredMinutes} MIN READ</p>}

							<a
								href={`/blog/${featured.id}/`}
								class="label link-underline mt-9 inline-flex w-fit items-center gap-x-2 text-app-ink"
							>
								{featuredCtaLabel}
								<Icon name="arrow-right" class="h-3 w-3" />
							</a>
						</div>
					</article>
				</div>
			</section>

			{/* ── ② 最新文章格線 ─────────────────────────────── */}
			<section class="page-wide band" data-home-latest>
				<div class="mx-auto max-w-6xl">
					<div class="flex flex-col gap-y-8 md:flex-row md:items-end md:justify-between md:gap-x-12">
						<div>
							<p class="label">{eyebrow}</p>
							<h2 class="title-h2 title-caps mt-5 text-app-ink">{heading}</h2>
						</div>

						{categories.length > 0 && (
							<div class="flex flex-wrap gap-x-7 gap-y-3">
								<button
									type="button"
									class="filter-text label"
									data-home-filter=""
									data-active="true"
								>
									{allLabel}
								</button>
								{categories.map((category) => (
									<button type="button" class="filter-text label" data-home-filter={category}>
										{category}
									</button>
								))}
							</div>
						)}
					</div>

					<hr class="rule mt-10 md:mt-12" />

					<p data-home-empty class="body-small py-20 text-center" hidden>
						{emptyText}
					</p>

					<div class="mt-14 grid grid-cols-1 gap-x-12 gap-y-16 sm:grid-cols-2 md:mt-16 lg:grid-cols-3">
						{rest.map((post, index) => (
							<BlogCard
								post={post}
								variant="grid"
								showReadingTime={showReadingTime}
								hidden={index >= gridCount}
							/>
						))}
					</div>

					<div class="mt-16 text-center md:mt-20">
						<a
							href="/blog"
							class="label inline-flex items-center gap-x-2 border border-app-gray-300 px-7 py-4 text-app-ink transition-colors hover:border-app-ink"
						>
							{ctaLabel}
							<Icon name="arrow-right" class="h-3 w-3" />
						</a>
					</div>
				</div>
			</section>
		</>
	)
}

<script is:inline define:vars={{ gridCount }}>
	// 首頁的分類篩選。跟 /blog 的篩選一樣是純前端的：所有卡片都已經在
	// 頁面上了，這裡只是決定「哪幾張顯示出來」，所以點下去是瞬間的，
	// 不會重新載入頁面。
	//
	// 兩條規則：
	//   1. 不論選哪個分類，格線最多只顯示 gridCount 張（預設 6）——
	//      首頁的責任是給一個入口，不是把所有文章倒出來。
	//   2. 選到的分類目前沒有文章時顯示一行說明，不留一片空白。
	(function () {
		var root = document.querySelector('[data-home-latest]');
		if (!root) return;

		var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-home-filter]'));
		var cards = Array.prototype.slice.call(root.querySelectorAll('[data-post-card]'));
		var empty = root.querySelector('[data-home-empty]');

		function apply(category) {
			var shown = 0;
			cards.forEach(function (card) {
				var match = !category || card.dataset.category === category;
				var show = match && shown < gridCount;
				card.hidden = !show;
				if (match) shown += 1;
			});
			if (empty) empty.hidden = shown > 0;
			buttons.forEach(function (button) {
				button.dataset.active = (button.dataset.homeFilter || '') === category ? 'true' : 'false';
			});
		}

		buttons.forEach(function (button) {
			button.addEventListener('click', function () {
				apply(button.dataset.homeFilter || '');
			});
		});
	})();
</script>
