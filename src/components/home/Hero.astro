---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const [heroEntry] = await getCollection('homeHero');
const [siteSettings] = await getCollection('siteSettings');
if (!heroEntry || !siteSettings) {
	throw new Error('找不到「首頁-Hero.md」或「網站設定.md」，請確認 src/content/編輯 資料夾裡有這兩個檔案。');
}
const { eyebrow, subtitle, backgroundImage, backgroundImageAlt } = heroEntry.data;
const siteTitle = siteSettings.data.title;

// 改版備註（2026-08-04）：
// 第一屏改成攝影集封面式的滿版照片。原本的兩顆按鈕與整片漸層遮罩
// 都拿掉了——按鈕會讓版面讀起來像「部落格首頁」而不是「作品集封面」，
// 整片遮罩則會壓掉照片本身的層次。
// Obsidian 的 primaryButtonLabel / secondaryButtonLabel 欄位保留但
// 不再顯示，之後想改回來隨時可以接上。
---

<section class="relative flex h-[100svh] min-h-[560px] w-full items-end overflow-hidden bg-app-ink">
	<Image
		src={backgroundImage}
		alt={backgroundImageAlt}
		class="absolute inset-0 h-full w-full object-cover"
		widths={[640, 1024, 1600, 2200]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<!-- 只在最底部壓一層極淡的暗，純粹為了文字可讀性，不改變照片調子 -->
	<div
		class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/45 to-transparent"
		aria-hidden="true"
	></div>

	<!-- 標題與抬頭導覽共用同一條窄邊軸線，左緣切齊 -->
	<div class="page-narrow relative z-10 w-full pb-14 md:pb-20">
		<p class="label text-white/70">{eyebrow}</p>
		<h1 class="title-display mt-6 max-w-[14ch] text-white">
			{siteTitle}
		</h1>
		<p class="body-small mt-6 max-w-md text-white/75">
			{subtitle}
		</p>
	</div>

	<a
		href="#about"
		aria-label="向下捲動"
		class="label scroll-hint absolute bottom-14 z-10 hidden text-white/60 transition-colors hover:text-white md:block"
	>
		Scroll
	</a>
</section>

<style>
	.scroll-hint {
		right: var(--page-margin-narrow);
	}
</style>
