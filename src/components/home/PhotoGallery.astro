---
import { getCollection } from 'astro:content';
import AlbumFlipbook from '../AlbumFlipbook.astro';

const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);

// 排序邏輯備註（2026-08-03）：
// 目前依 Obsidian 相簿檔案裡的 `order` 欄位手動排序。
// 未來規劃：等網站對 Google 開放搜尋（src/consts.ts 的
// SITE_IS_PUBLISHED 改成 true）之後，這裡要改成依「點擊率／
// 停留時間」等瀏覽數據自動排序精選攝影集，讓表現好的主題排在前面。
// 這需要先接上分析工具（例如 Cloudflare Web Analytics 或 GA4）
// 收集數據，屬於之後才會做的功能，先在這裡留紀錄，跟 Google
// 搜尋開放時一起上線。相關備註也寫在 src/consts.ts 和使用說明.md。
---

<section id="gallery" class="bg-app-gray-100 px-6 py-20 md:py-28">
	<div class="mx-auto max-w-6xl">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-6 md:mb-14">
			<div>
				<p class="text-xs font-medium uppercase tracking-[0.3em] text-app-gray-500">Photography</p>
				<h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-app-ink md:text-4xl">
					精選攝影集
				</h2>
			</div>
			<a
				href="/portfolio"
				class="text-xs font-medium uppercase tracking-[0.2em] text-app-gray-500 transition-colors duration-300 hover:text-app-accent"
			>
				瀏覽完整攝影集 →
			</a>
		</div>

		<AlbumFlipbook albums={albums} />
	</div>
</section>
