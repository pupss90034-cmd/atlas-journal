---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { SITE_IS_PUBLISHED } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/images/default-cover.jpg' } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
{!SITE_IS_PUBLISHED && <meta name="robots" content="noindex, nofollow" />}

<!--
	Font — 一字體到底。
	EB Garamond 負責所有英文與數字；中文自動落到 Noto Serif TC
	（Google Fonts 上的 Source Han Serif／思源明體）。
	只載入 400 / 400 italic / 500，避免版面出現粗體。
-->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+TC:wght@300;400;500&display=swap"
	rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!--
	內容保護（2026-08-09 新增，全站生效）

	做了兩件事：
	1. 圖片上按右鍵不跳出選單 → 擋掉「另存圖片」
	2. 文章內文（.no-copy）不能選取、複製、剪下

	必須先知道這件事能做到什麼程度：
	這只擋得掉「順手右鍵存檔」和「拖曳選取複製」的一般讀者。
	會用開發者工具、關閉 JavaScript、看網頁原始碼、或直接把圖片
	網址貼到新分頁的人完全擋不住——瀏覽器必須把圖片和文字下載到
	使用者的電腦才能顯示，這在技術上沒有辦法避免。

	想要更實際的保護：
	- 照片：上傳前把長邊壓到 1600px 以內，或加上不影響觀看的浮水印
	- 文章：把發佈時間留下來（RSS、搜尋引擎索引都會記錄），
	  真的被抄襲時那份時間戳才是有用的證據
-->
<script is:inline>
	(function () {
		// 圖片右鍵：只擋圖片，其他地方的右鍵維持正常
		// （整頁封鎖右鍵會連「上一頁」「重新整理」都不能用，很擾人）
		document.addEventListener('contextmenu', function (e) {
			var el = e.target;
			if (el && (el.tagName === 'IMG' || el.tagName === 'PICTURE')) e.preventDefault();
		});

		// 拖曳圖片到桌面 = 另存，一併擋掉
		document.addEventListener('dragstart', function (e) {
			var el = e.target;
			if (el && el.tagName === 'IMG') e.preventDefault();
		});

		// 文章內文的複製與剪下
		['copy', 'cut'].forEach(function (type) {
			document.addEventListener(type, function (e) {
				var el = e.target;
				var node = el && el.nodeType === 3 ? el.parentElement : el;
				if (node && node.closest && node.closest('.no-copy')) {
					// 程式碼區塊仍然放行，否則貼上範例會變成不可能
					if (node.closest('pre') || node.closest('code')) return;
					e.preventDefault();
				}
			});
		});
	})();
</script>
