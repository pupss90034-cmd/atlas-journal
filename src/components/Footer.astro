---
import { SITE_TITLE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="px-6 pb-10 pt-16">
	<div class="container mx-auto max-w-5xl">
		<div class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-app-accent p-8 md:flex-row md:items-center lg:p-10">
			<div>
				<p class="text-xl font-semibold tracking-tight text-app-text md:text-2xl">
					{SITE_TITLE}
				</p>
				<p class="mt-1 text-sm text-app-text/70">感謝閱讀，歡迎訂閱最新文章。</p>
			</div>
			<a
				href="/rss.xml"
				class="inline-flex items-center justify-center rounded-full bg-app-text px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90"
			>
				訂閱 RSS
			</a>
		</div>
		<p class="mt-6 text-center text-xs text-app-gray-500">
			&copy; {year} {SITE_TITLE}. All rights reserved.
		</p>
	</div>
</footer>
