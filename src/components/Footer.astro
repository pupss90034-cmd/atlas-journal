---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const year = new Date().getFullYear();
---

<footer class="px-6 pb-6 pt-10">
	<div class="container mx-auto max-w-5xl">
		<div class="rounded-2xl bg-app-accent p-5 pb-6 lg:p-10">
			<div
				class="mb-4 border-b border-app-text/10 pb-5 md:mb-6 md:flex md:items-start md:justify-between md:pb-10 lg:mb-8 lg:pb-16"
			>
				<p
					class="mb-2.5 max-w-[280px] text-2xl font-semibold leading-tight tracking-tight text-app-text md:max-w-[350px] md:text-3xl lg:max-w-[420px] lg:text-5xl"
				>
					{SITE_TITLE}
				</p>
				<p
					class="max-w-[280px] text-sm font-medium leading-snug text-app-text/80 md:max-w-[300px] md:text-base lg:max-w-[380px] lg:text-xl"
				>
					{SITE_DESCRIPTION}
				</p>
			</div>
			<div class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-center md:gap-10">
				<a
					href="/rss.xml"
					class="inline-flex items-center justify-center gap-2 rounded-full bg-app-text px-6 py-3 text-sm font-medium text-white transition-opacity hover:opacity-90 md:text-base"
				>
					訂閱 RSS
				</a>
				<a
					href="https://github.com/pupss90034-cmd/atlas-journal"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 rounded-full border border-app-text/20 px-6 py-3 text-sm font-medium text-app-text transition-colors hover:bg-app-text hover:text-white md:text-base"
				>
					GitHub
				</a>
			</div>
		</div>
		<p class="mt-6 text-center text-xs text-app-gray-500">&copy; {year} {SITE_TITLE}. All rights reserved.</p>
	</div>
</footer>
