---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const year = new Date().getFullYear();

// Placeholder social links — swap the href="#" values for your real profile
// URLs whenever you're ready; the layout is already final.
const socialLinks = [
	{
		name: 'Instagram',
		href: '#',
		path: 'M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.21.6 1.76 1.15.5.5.9 1.1 1.15 1.76.25.64.42 1.37.47 2.43C21.99 8.94 22 9.28 22 12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.25-1.37.42-2.43.47C15.06 21.99 14.72 22 12 22s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.21 1.15-1.76A4.9 4.9 0 0 1 5.44.54C6.08.29 6.81.12 7.87.07 8.94.01 9.28 0 12 0zm0 5a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm7.25-3.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5z',
	},
	{
		name: 'Facebook',
		href: '#',
		path: 'M13.5 22v-8.5h2.85l.43-3.31H13.5V8.05c0-.96.27-1.61 1.64-1.61h1.75V3.5c-.3-.04-1.34-.13-2.55-.13-2.52 0-4.24 1.54-4.24 4.36v2.44H7.24v3.31h2.86V22h3.4z',
	},
	{
		name: 'YouTube',
		href: '#',
		path: 'M23.5 6.5a3 3 0 0 0-2.1-2.1C19.6 4 12 4 12 4s-7.6 0-9.4.4A3 3 0 0 0 .5 6.5 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.5 3 3 0 0 0 2.1 2.1C4.4 20 12 20 12 20s7.6 0 9.4-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.5zM9.6 15.5v-7l6.3 3.5-6.3 3.5z',
	},
	{
		name: 'Pinterest',
		href: '#',
		path: 'M12 0a12 12 0 0 0-4.37 23.17c-.06-.94-.11-2.38.02-3.4.12-.93.8-5.9.8-5.9s-.2-.41-.2-1.01c0-.94.55-1.65 1.23-1.65.58 0 .86.44.86.96 0 .58-.37 1.46-.56 2.27-.16.68.34 1.23 1 1.23 1.2 0 2.13-1.27 2.13-3.1 0-1.62-1.16-2.75-2.83-2.75-1.93 0-3.06 1.44-3.06 2.94 0 .58.22 1.2.5 1.54a.2.2 0 0 1 .05.19c-.05.22-.17.68-.2.78-.03.13-.1.16-.24.1-.9-.42-1.46-1.73-1.46-2.79 0-2.27 1.65-4.36 4.76-4.36 2.5 0 4.44 1.78 4.44 4.16 0 2.48-1.56 4.48-3.74 4.48-.73 0-1.42-.38-1.65-.83l-.45 1.72c-.16.63-.6 1.42-.9 1.9A12 12 0 1 0 12 0z',
	},
];
---

<footer class="mt-10 border-t border-app-gray-200 bg-app-accent-soft px-6 py-16 md:py-20">
	<div class="container mx-auto max-w-2xl text-center">
		<p class="font-serif text-2xl font-semibold tracking-tight text-app-text md:text-3xl">
			{SITE_TITLE}
		</p>
		<p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-app-gray-600 md:text-base">
			{SITE_DESCRIPTION}
		</p>

		<div class="mt-6 flex items-center justify-center gap-3">
			{
				socialLinks.map((social) => (
					<a
						href={social.href}
						aria-label={social.name}
						target="_blank"
						rel="noopener noreferrer"
						class="flex h-9 w-9 items-center justify-center rounded-full border border-app-gray-300/60 text-app-gray-600 transition-colors duration-300 hover:border-app-accent hover:bg-app-accent hover:text-app-body"
					>
						<svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
							<path d={social.path} />
						</svg>
					</a>
				))
			}
		</div>
	</div>

	<div class="container mx-auto mt-10 flex max-w-5xl flex-col items-center gap-3 border-t border-app-gray-300/60 pt-6 text-center md:flex-row md:justify-between md:text-left">
		<p class="text-xs uppercase tracking-[0.1em] text-app-gray-500">&copy; {year} {SITE_TITLE}</p>
		<a
			href="https://github.com/pupss90034-cmd/atlas-journal"
			target="_blank"
			rel="noopener noreferrer"
			class="text-xs font-medium uppercase tracking-[0.15em] text-app-gray-500 transition-colors hover:text-app-text"
		>
			GitHub
		</a>
	</div>
</footer>
