---
import { getCollection } from 'astro:content';
import { parseEditableBlock, parseMarkdownTable } from '../utils/editableBody';
import { MAP_WIDTH, MAP_HEIGHT, WORLD_PATH, project } from '../data/world-map';

interface Props {
	/** 目前所有文章用到的標籤 → 篇數 */
	tagCounts: Map<string, number>;
}

const { tagCounts } = Astro.props;

// ── 這個元件在做什麼 ────────────────────────────────────
//
// 你的文章標籤實際上等於「這篇寫的是哪裡」，所以純文字的標籤列其實
// 浪費了它——一排「法國 西班牙 紐西蘭 台灣 大溪地」讀者只能一個一個看過去，
// 看不出這些地方在哪、離多遠、你走過多大的範圍。地圖一眼就講完了。
//
// 但地圖不能取代文字：地圖上的點很小、手機上更小，而且看不出「這個標籤
// 叫什麼」。所以每個點旁邊一律附上標籤文字，點文字或點點都能篩選。
//
// 座標從「編輯/標籤地圖.md」的表格讀進來（Obsidian 的表格可以像 Excel
// 一樣按 Tab 編輯）。沒寫在表格裡的標籤不會消失，會排在地圖下方。

const [entry] = await getCollection('tagMap');
const heading = entry?.data.heading ?? '去過的地方';
const otherTagsLabel = entry?.data.otherTagsLabel ?? '其他標籤';
const { intro } = parseEditableBlock(entry?.body);

type Anchor = '上' | '下' | '左' | '右';
const ANCHORS: Anchor[] = ['上', '下', '左', '右'];

interface Pin {
	tag: string;
	count: number;
	x: number;
	y: number;
	anchor: Anchor;
}

const pins: Pin[] = [];
const placedTags = new Set<string>();

for (const row of parseMarkdownTable(entry?.body)) {
	const tag = (row['標籤'] ?? '').trim();
	const lat = Number(row['緯度']);
	const lon = Number(row['經度']);

	// 座標打錯／留空不會讓網站壞掉，這一列直接略過，
	// 該標籤會自動掉到下方的「其他標籤」文字列。
	if (tag === '' || !Number.isFinite(lat) || !Number.isFinite(lon)) continue;
	// 表格裡有、但目前沒有任何文章在用的標籤不顯示，
	// 免得地圖上出現點了卻沒東西的地方。
	const count = tagCounts.get(tag);
	if (!count) continue;
	if (placedTags.has(tag)) continue;

	const rawAnchor = (row['文字位置'] ?? '').trim() as Anchor;
	const anchor: Anchor = ANCHORS.includes(rawAnchor) ? rawAnchor : '右';

	const { x, y } = project(lat, lon);
	pins.push({ tag, count, x, y, anchor });
	placedTags.add(tag);
}

// 沒有座標的標籤（例如「露營車生活系列」「登山」這種不是地點的），
// 仍然照原本的方式排成一列文字，一樣可以點。
const otherTags = [...tagCounts.keys()]
	.filter((tag) => !placedTags.has(tag))
	.sort((a, b) => a.localeCompare(b, 'zh-Hant'));

// 點的大小照篇數微調（最小 3.2、最多加到 5.6），差距刻意做得很小——
// 這是給人一個「這裡寫得比較多」的餘光印象，不是要做成資料圖表。
const maxCount = Math.max(1, ...pins.map((p) => p.count));
function radius(count: number) {
	return +(3.2 + (count / maxCount) * 2.4).toFixed(2);
}

// 文字相對於點的位置。座標系統是地圖畫布（1000 寬），
// 所以這裡的數字是畫布單位不是 px。
function labelPosition(pin: Pin) {
	const gap = radius(pin.count) + 4.5;

	// 保險：太靠近左右邊緣的點，文字往外放會被裁掉。
	// 這裡自動翻到另一邊，你在表格裡填錯方向也不會有半個地名不見。
	let anchor = pin.anchor;
	if (anchor === '右' && pin.x > MAP_WIDTH - 120) anchor = '左';
	else if (anchor === '左' && pin.x < 120) anchor = '右';

	switch (anchor) {
		case '上':
			return { dx: 0, dy: -gap - 2, textAnchor: 'middle' as const };
		case '下':
			return { dx: 0, dy: gap + 9, textAnchor: 'middle' as const };
		case '左':
			return { dx: -gap, dy: 3.5, textAnchor: 'end' as const };
		default:
			return { dx: gap, dy: 3.5, textAnchor: 'start' as const };
	}
}
---

<div class="tag-map-block border-t border-app-gray-200 py-10 md:py-12">
	<div class="axis">
		<p class="label">{heading}</p>
		{intro && <p class="body-small mx-auto mt-4 max-w-[38ch]">{intro}</p>}
	</div>

	{
		pins.length > 0 && (
			<div class="tag-map mx-auto mt-9 max-w-4xl">
				<svg
					viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
					role="group"
					aria-label={`${heading}：地圖上共 ${pins.length} 個地點`}
					class="block h-auto w-full"
				>
					{/* 世界輪廓：只有線，沒有填色。地圖在這裡是背景不是主角，
					    所以線壓得很淡，讓標籤的墨點是畫面上最深的東西。 */}
					<path d={WORLD_PATH} class="map-outline" />

					{pins.map((pin) => {
						const { dx, dy, textAnchor } = labelPosition(pin);
						return (
							<g
								class="tag-btn map-pin"
								data-tag={pin.tag}
								role="button"
								tabindex="0"
								aria-label={`${pin.tag}，${pin.count} 篇`}
							>
								{/* 看不見的大圓：手指與滑鼠的實際點擊範圍。
								    真正的墨點只有 3–5 單位，直接拿它當按鈕在手機上點不到。 */}
								<circle cx={pin.x} cy={pin.y} r="16" class="map-hit" />
								<circle cx={pin.x} cy={pin.y} r={radius(pin.count)} class="map-dot" />
								<text x={pin.x + dx} y={pin.y + dy} text-anchor={textAnchor} class="map-label">
									{pin.tag}
								</text>
							</g>
						);
					})}
				</svg>
			</div>
		)
	}

	{
		otherTags.length > 0 && (
			<div class="mx-auto mt-8 flex max-w-3xl flex-wrap items-baseline justify-center gap-x-7 gap-y-3">
				<span class="label text-app-gray-300">{otherTagsLabel}</span>
				{otherTags.map((tag) => (
					<button type="button" data-tag={tag} class="tag-btn label">
						{tag}
					</button>
				))}
			</div>
		)
	}
</div>

<style>
	/* 地圖輪廓：一條很淡的線。stroke-width 用畫布單位，
	   所以縮放時線的粗細會跟著地圖等比例變化，不會在小螢幕上變粗。 */
	.map-outline {
		fill: none;
		/* gray-300 而不是更淡的 gray-200：地圖是背景沒錯，但淡到看不出
		   是哪塊陸地就失去意義了。這條線要剛好「認得出形狀、但不搶戲」。 */
		stroke: var(--color-app-gray-300);
		stroke-width: 0.9;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.map-pin {
		cursor: pointer;
	}
	.map-hit {
		fill: transparent;
	}

	/* 未選取：中空的圈。選取：填滿的實心點。
	   跟全站一樣不用第二個顏色來表示狀態，只用「空 / 實」與墨色深淺。 */
	.map-dot {
		fill: var(--color-app-body);
		stroke: var(--color-app-gray-500);
		stroke-width: 1.4;
		transition: fill 0.4s ease, stroke 0.4s ease;
	}
	.map-label {
		/* 單位是地圖畫布單位（整張圖寬 1000），不是螢幕 px——
		   地圖縮小時字會跟著等比例縮小。14 這個值在桌機（約 900px 寬）
		   換算出來大約 12.5px，剛好落在全站的「圖說」字級上。 */
		font-size: 14px;
		letter-spacing: 0.04em;
		fill: var(--color-app-gray-500);
		transition: fill 0.4s ease;
		/* 標籤文字不隨地圖縮放變形，在手機上才讀得到 */
		paint-order: stroke;
		stroke: var(--color-app-body);
		stroke-width: 3px;
		stroke-linejoin: round;
	}

	.map-pin:hover .map-dot,
	.map-pin:focus-visible .map-dot {
		fill: var(--color-app-gray-400);
		stroke: var(--color-app-ink);
	}
	.map-pin:hover .map-label,
	.map-pin:focus-visible .map-label {
		fill: var(--color-app-ink);
	}

	.map-pin[data-active='true'] .map-dot {
		fill: var(--color-app-ink);
		stroke: var(--color-app-ink);
	}
	.map-pin[data-active='true'] .map-label {
		fill: var(--color-app-ink);
	}

	.map-pin:focus {
		outline: none;
	}

	/* 手機：整張世界地圖塞進 375px 寬的螢幕，歐洲那幾個點會擠成一團、
	   地名也會小到讀不出來。改成給地圖一個最小寬度、可以左右滑，
	   保住「看得懂」這件事——寧可滑一下，也不要一張看不清楚的圖。 */
	@media (max-width: 640px) {
		.tag-map {
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
		}
		.tag-map svg {
			min-width: 46rem;
		}
	}
</style>

<script>
	// 讓地圖上的點也能用鍵盤操作（Tab 移動、Enter/空白鍵選取）。
	// 篩選本身的邏輯統一寫在 /blog 頁面裡，這裡只負責把鍵盤事件
	// 轉成一次點擊，避免同一段邏輯有兩份實作。
	document.querySelectorAll<SVGGElement>('.map-pin').forEach((pin) => {
		pin.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			pin.dispatchEvent(new MouseEvent('click', { bubbles: true }));
		});
	});
</script>
