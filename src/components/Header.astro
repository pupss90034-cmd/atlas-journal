---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

interface Props {
	// 首頁與文章頁的第一屏是滿版照片，抬頭先透明浮在照片上（白字），
	// 捲過第一屏之後才轉成白底黑字。其餘頁面一開始就是白底。
	transparent?: boolean;
}

const { transparent = false } = Astro.props;

// 改版重點：抬頭不再顯示網站名稱。
// 站名只出現在首頁第一屏與 Footer，抬頭只留導覽，
// 讓照片與內容成為畫面主角，也解決原本三欄擠在一起的問題。
const nav = [
	{ label: 'Index', href: '/' },
	{ label: 'Journal', href: '/blog' },
	{ label: 'Portfolio', href: '/portfolio' },
	{ label: 'About', href: '/about' },
];

const socialLinks = [
	{ name: 'Instagram', href: '#', path: 'M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.21.6 1.76 1.15.5.5.9 1.1 1.15 1.76.25.64.42 1.37.47 2.43C21.99 8.94 22 9.28 22 12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.25-1.37.42-2.43.47C15.06 21.99 14.72 22 12 22s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.21 1.15-1.76A4.9 4.9 0 0 1 5.44.54C6.08.29 6.81.12 7.87.07 8.94.01 9.28 0 12 0zm0 5a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm7.25-3.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5z' },
	{ name: 'Facebook', href: '#', path: 'M13.5 22v-8.5h2.85l.43-3.31H13.5V8.05c0-.96.27-1.61 1.64-1.61h1.75V3.5c-.3-.04-1.34-.13-2.55-.13-2.52 0-4.24 1.54-4.24 4.36v2.44H7.24v3.31h2.86V22h3.4z' },
	{ name: 'YouTube', href: '#', path: 'M23.5 6.5a3 3 0 0 0-2.1-2.1C19.6 4 12 4 12 4s-7.6 0-9.4.4A3 3 0 0 0 .5 6.5 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.5 3 3 0 0 0 2.1 2.1C4.4 20 12 20 12 20s7.6 0 9.4-.4a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.5zM9.6 15.5v-7l6.3 3.5-6.3 3.5z' },
	{ name: 'Pinterest', href: '#', path: 'M12 0a12 12 0 0 0-4.37 23.17c-.06-.94-.11-2.38.02-3.4.12-.93.8-5.9.8-5.9s-.2-.41-.2-1.01c0-.94.55-1.65 1.23-1.65.58 0 .86.44.86.96 0 .58-.37 1.46-.56 2.27-.16.68.34 1.23 1 1.23 1.2 0 2.13-1.27 2.13-3.1 0-1.62-1.16-2.75-2.83-2.75-1.93 0-3.06 1.44-3.06 2.94 0 .58.22 1.2.5 1.54a.2.2 0 0 1 .05.19c-.05.22-.17.68-.2.78-.03.13-.1.16-.24.1-.9-.42-1.46-1.73-1.46-2.79 0-2.27 1.65-4.36 4.76-4.36 2.5 0 4.44 1.78 4.44 4.16 0 2.48-1.56 4.48-3.74 4.48-.73 0-1.42-.38-1.65-.83l-.45 1.72c-.16.63-.6 1.42-.9 1.9A12 12 0 1 0 12 0z' },
];

// 熱門搜尋標籤：從所有文章實際使用的 tags 動態算出出現次數最高的前 5 個。
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const fallbackSearches = ['露營車生活', '紐西蘭', '大溪地', '飯店日常', '攝影集'];
const popularSearches =
	tagCounts.size > 0
		? [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5).map(([tag]) => tag)
		: fallbackSearches;
---

<header id="site-header" data-transparent={transparent ? 'true' : 'false'} class="fixed inset-x-0 top-0 z-50">
	<div class="page-narrow flex items-center justify-between py-6">
		<nav class="hidden items-baseline gap-10 md:flex">
			{nav.map((item) => (
				<a href={item.href} class="header-link label transition-colors duration-500">
					{item.label}
				</a>
			))}
		</nav>

		<!-- 手機版：左側只留一個選單鈕，右側搜尋，維持左右對稱的窄邊 -->
		<button
			id="menu-toggle"
			type="button"
			aria-label="開啟選單"
			aria-expanded="false"
			class="header-link label md:hidden"
		>
			Menu
		</button>

		<button
			id="search-open"
			type="button"
			aria-label="開啟搜尋"
			class="header-link label transition-colors duration-500"
		>
			Search
		</button>
	</div>
</header>

<!-- Mobile full-screen drawer -->
<div id="mobile-drawer" class="fixed inset-0 z-50 hidden flex-col bg-app-body">
	<div class="page-narrow flex items-center justify-end py-6">
		<button id="drawer-close" type="button" aria-label="關閉選單" class="label text-app-ink">Close</button>
	</div>

	<nav class="flex flex-1 flex-col items-center justify-center gap-9">
		{nav.map((item) => (
			<a href={item.href} class="title-lg text-app-ink transition-opacity hover:opacity-50">
				{item.label}
			</a>
		))}
		<button id="drawer-search-open" type="button" class="label mt-4">Search</button>
	</nav>

	<div class="flex items-center justify-center gap-8 px-6 py-12">
		{socialLinks.map((social) => (
			<a
				href={social.href}
				aria-label={social.name}
				target="_blank"
				rel="noopener noreferrer"
				class="text-app-gray-400 transition-colors duration-500 hover:text-app-ink"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4 fill-current"><path d={social.path} /></svg>
			</a>
		))}
	</div>
</div>

<!-- Search overlay：整頁白底、中軸置中，維持攝影集的安靜感 -->
<div id="search-modal" class="fixed inset-0 z-[60] hidden flex-col bg-app-body">
	<div class="page-narrow flex items-center justify-end py-6">
		<button id="search-close" type="button" aria-label="關閉搜尋" class="label text-app-ink">Close</button>
	</div>

	<div class="page-wide flex flex-1 flex-col items-center justify-center pb-32">
		<div class="w-full max-w-2xl">
			<form id="search-form" action="/blog" method="get" class="border-b border-app-gray-300 pb-4">
				<label for="search-input" class="label">Search</label>
				<input
					id="search-input"
					name="q"
					type="text"
					autocomplete="off"
					placeholder="輸入關鍵字，按 Enter"
					class="mt-5 w-full bg-transparent text-2xl text-app-ink placeholder:text-app-gray-300 focus:outline-none md:text-4xl"
				/>
			</form>

			<div class="mt-10 flex flex-wrap items-baseline gap-x-7 gap-y-3">
				<span class="label">Popular</span>
				{popularSearches.map((tag) => (
					<button type="button" data-tag={tag} class="search-tag body-small link-underline">
						{tag}
					</button>
				))}
			</div>
		</div>
	</div>
</div>

<style>
	/* 透明狀態：浮在滿版照片上，白字無底色無分隔線 */
	#site-header[data-transparent='true'] {
		background: transparent;
		border-bottom: 1px solid transparent;
	}
	#site-header[data-transparent='true'] .header-link {
		color: rgba(255, 255, 255, 0.85);
	}
	#site-header[data-transparent='true'] .header-link:hover {
		color: #ffffff;
	}

	/* 實底狀態：白紙、一條 1px 灰線，不用陰影也不用色塊 */
	#site-header[data-transparent='false'],
	#site-header.is-scrolled {
		background: var(--color-app-body);
		border-bottom: 1px solid var(--color-app-gray-200);
	}
	#site-header[data-transparent='false'] .header-link,
	#site-header.is-scrolled .header-link {
		color: var(--color-app-gray-400);
	}
	#site-header[data-transparent='false'] .header-link:hover,
	#site-header.is-scrolled .header-link:hover {
		color: var(--color-app-ink);
	}

	#mobile-drawer.flex {
		display: flex;
	}
	#search-modal.flex {
		display: flex;
	}
</style>

<script>
	const header = document.getElementById('site-header');

	function updateHeaderOnScroll() {
		if (!header) return;
		const scrolled = window.scrollY > 40;
		header.classList.toggle('is-scrolled', scrolled);
	}
	updateHeaderOnScroll();
	window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });

	// Mobile drawer
	const menuToggle = document.getElementById('menu-toggle');
	const drawer = document.getElementById('mobile-drawer');
	const drawerClose = document.getElementById('drawer-close');

	function openDrawer() {
		drawer?.classList.remove('hidden');
		drawer?.classList.add('flex');
		document.body.style.overflow = 'hidden';
		menuToggle?.setAttribute('aria-expanded', 'true');
	}
	function closeDrawer() {
		drawer?.classList.add('hidden');
		drawer?.classList.remove('flex');
		document.body.style.overflow = '';
		menuToggle?.setAttribute('aria-expanded', 'false');
	}
	menuToggle?.addEventListener('click', openDrawer);
	drawerClose?.addEventListener('click', closeDrawer);

	// Search overlay
	const searchModal = document.getElementById('search-modal');
	const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
	const searchOpenButtons = [
		document.getElementById('search-open'),
		document.getElementById('drawer-search-open'),
	];
	const searchClose = document.getElementById('search-close');

	function openSearch() {
		closeDrawer();
		searchModal?.classList.remove('hidden');
		searchModal?.classList.add('flex');
		document.body.style.overflow = 'hidden';
		searchInput?.focus();
	}
	function closeSearch() {
		searchModal?.classList.add('hidden');
		searchModal?.classList.remove('flex');
		document.body.style.overflow = '';
	}
	searchOpenButtons.forEach((btn) => btn?.addEventListener('click', openSearch));
	searchClose?.addEventListener('click', closeSearch);

	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		if (searchModal && !searchModal.classList.contains('hidden')) closeSearch();
		else if (drawer && !drawer.classList.contains('hidden')) closeDrawer();
	});

	document.querySelectorAll<HTMLButtonElement>('.search-tag').forEach((tag) => {
		tag.addEventListener('click', () => {
			const term = tag.dataset.tag ?? '';
			window.location.href = `/blog?tag=${encodeURIComponent(term)}`;
		});
	});
</script>
