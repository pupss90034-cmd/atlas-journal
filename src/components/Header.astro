---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const nav = [
	{ label: '首頁', href: '/' },
	{ label: '文章', href: '/blog' },
	{ label: '關於', href: '/about' },
];
---

<header class="border-b border-app-gray-200">
	<div class="container mx-auto max-w-5xl px-6">
		<!-- utility row -->
		<div class="flex items-center justify-between py-3">
			<ul class="hidden items-center gap-6 md:flex">
				{
					nav.map((item) => (
						<li>
							<HeaderLink href={item.href}>{item.label}</HeaderLink>
						</li>
					))
				}
			</ul>

			<button
				id="menu-toggle"
				type="button"
				aria-label="開啟選單"
				aria-expanded="false"
				class="flex h-8 w-8 items-center justify-center rounded-full border border-app-gray-200 md:hidden"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none">
					<path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
			</button>

			<a
				href="/rss.xml"
				class="text-xs font-medium uppercase tracking-[0.15em] text-app-gray-500 transition-colors hover:text-app-text"
			>
				訂閱 RSS
			</a>
		</div>

		<!-- site title -->
		<div class="pb-6 text-center md:pb-8">
			<a href="/" class="inline-block" aria-label="首頁">
				<span
					class="font-serif text-3xl font-semibold tracking-[0.06em] text-app-accent md:text-4xl lg:text-5xl"
				>
					{SITE_TITLE}
				</span>
			</a>
		</div>
	</div>

	<nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-app-gray-200 px-6 py-3 md:hidden">
		{
			nav.map((item) => (
				<HeaderLink href={item.href} class="block! py-2">
					{item.label}
				</HeaderLink>
			))
		}
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('flex');
		menu?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!!isOpen));
	});
</script>
